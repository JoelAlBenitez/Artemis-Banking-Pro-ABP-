@model ArtemisBankingPro.Core.Application.ViewModels.Cajero.RetiroViewModel
@{
    ViewData["Title"] = "Realizar Retiro";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Realizar Retiro</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Retiro" method="post">
                        <div class="mb-3">
                            <label asp-for="NumeroCuentaOrigen" class="form-label">Número de cuenta origen</label>
                            <input asp-for="NumeroCuentaOrigen" class="form-control" placeholder="Ingrese el número de cuenta" />
                            <span asp-validation-for="NumeroCuentaOrigen" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Monto" class="form-label">Monto a retirar</label>
                            <input asp-for="Monto" type="number" step="0.01" class="form-control" placeholder="0.00" />
                            <span asp-validation-for="Monto" class="text-danger"></span>
                        </div>
                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-primary">Realizar retiro</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
