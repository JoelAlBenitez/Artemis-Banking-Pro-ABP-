@using Artemis_Banking_Pro.Core.Application.ViewModels.CreditCards
@model EditCardLimitViewModel

@{
    ViewData["Title"] = "Modificar Límite de Crédito";
}

<div class="container mt-4 mb-5 d-flex justify-content-center">
    <div class="card shadow-sm border-0" style="max-width: 500px; width: 100%;">
        <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
            <h2 class="fw-bold" style="font-family: 'Montserrat', sans-serif; color: #0F172A;">
                <a asp-action="Index" class="text-decoration-none text-muted me-2" title="Volver al Listado">
                    <i class="bi bi-arrow-left-circle"></i>
                </a>
                Editar Límite
            </h2>
            <p class="text-muted small mb-0">Modifique el límite de crédito de la tarjeta seleccionada.</p>
        </div>

        <div class="card-body p-4">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="CreditCardId" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm mb-4"></div>

                <div class="mb-4">
                    <label asp-for="CreditLimit" class="form-label fw-bold" style="color: #0F172A;">Nuevo Límite de Crédito (RD$)</label>
                    <div class="input-group shadow-sm">
                        <span class="input-group-text bg-primary text-white fw-bold">RD$</span>
                        <input asp-for="CreditLimit" type="number" step="0.01" min="0.01" class="form-control form-control-lg bg-light text-center fw-bold fs-4" placeholder="0.00" />
                    </div>
                    <span asp-validation-for="CreditLimit" class="text-danger small"></span>
                </div>

                <div class="alert alert-warning border-0 shadow-sm small">
                    <i class="bi bi-exclamation-triangle-fill me-2 text-warning"></i> 
                    El nuevo límite <strong>no puede ser inferior</strong> al monto que el cliente adeuda actualmente.
                </div>

                <div class="d-flex justify-content-end mt-4">
                    <a asp-action="Index" class="btn btn-light fw-bold shadow-sm me-2 px-4">Volver atrás</a>
                    <button type="submit" class="btn btn-primary fw-bold shadow-sm px-4" style="background-color: #4472C4; border-color: #4472C4;">
                        Guardar cambios <i class="bi bi-save ms-1"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
