@using Artemis_Banking_Pro.Core.Application.ViewModels.CreditCards
@using ArtemisBankingPro.Core.Domain.Common.Enum
@model CreditCardsListViewModel

@{
    ViewData["Title"] = "Gestión de Tarjetas de Crédito";
}

<div class="container mt-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold" style="font-family: 'Montserrat', sans-serif; color: #0F172A;">
                Gestión de Tarjetas de Crédito
            </h2>
            <p class="text-muted mb-0">Consulta y administra las tarjetas de crédito de los clientes.</p>
        </div>
        <div>
            <a asp-action="Assign" class="btn btn-primary fw-bold shadow-sm" style="background-color: #4472C4; border-color: #4472C4;">
                <i class="bi bi-credit-card me-2"></i> Asignar Tarjeta de Crédito
            </a>
        </div>
    </div>

    <!-- Filters and Alerts -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body bg-light">
            <form asp-action="IndexFilter" method="post" class="row gx-3 gy-2 align-items-center">
                <div class="col-sm-4">
                    <label class="fw-bold" style="color: #0F172A;">Buscar por Cédula:</label>
                    <input asp-for="Filter.IdCard" class="form-control shadow-sm" placeholder="Ingrese la cédula del cliente..." />
                </div>
                <div class="col-sm-4">
                    <label class="fw-bold" style="color: #0F172A;">Estado de la Tarjeta:</label>
                    <select asp-for="Filter.Status" class="form-select shadow-sm" asp-items="Html.GetEnumSelectList<CreditCardStatusFilter>()">
                    </select>
                </div>
                <div class="col-auto d-flex align-items-end" style="margin-top: 1.8rem;">
                    <button type="submit" class="btn btn-dark fw-bold shadow-sm">
                        <i class="bi bi-search me-1"></i> Buscar
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div asp-validation-summary="ModelOnly" class="alert alert-warning shadow-sm mb-4"></div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Credit Cards Table -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted" style="font-size: 0.8rem;">
                        <tr>
                            <th class="ps-4">NÚMERO DE TARJETA</th>
                            <th>CLIENTE</th>
                            <th>LÍMITE DE CRÉDITO</th>
                            <th>EXPIRACIÓN</th>
                            <th>MONTO ADEUDADO</th>
                            <th>ESTADO</th>
                            <th class="text-end pe-4">ACCIONES</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.CreditCards == null || !Model.CreditCards.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    No se encontraron tarjetas de crédito con los criterios indicados.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var card in Model.CreditCards)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold font-monospace">@card.MaskedCardNumber</td>
                                    <td>@card.FullNameCustomer</td>
                                    <td class="fw-bold text-success">RD$ @card.CreditLimit.ToString("N2")</td>
                                    <td class="text-muted">@card.ExpirationDate</td>
                                    <td class="fw-bold text-danger">RD$ @card.OwedAmount.ToString("N2")</td>
                                    <td>
                                        @if (card.StateCreditCard == "Cancelada")
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25">@card.StateCreditCard</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25">@card.StateCreditCard</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <a asp-action="Details" asp-route-id="@card.Id" class="btn btn-sm btn-outline-info fw-bold me-2" title="Ver consumos de la tarjeta">
                                            Detalles
                                        </a>
                                        @if (card.StateCreditCard != "Cancelada")
                                        {
                                            <a asp-action="Edit" asp-route-id="@card.Id" class="btn btn-sm btn-outline-primary fw-bold me-2">
                                                Editar
                                            </a>
                                            <a asp-action="Cancel" asp-route-id="@card.Id" class="btn btn-sm btn-outline-danger fw-bold">
                                                Cancelar
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4 d-flex justify-content-between align-items-center">
            <span class="text-muted small">Mostrando página @Model.Page de @Model.TotalPages (Total: @Model.TotalRecords tarjetas)</span>
            <ul class="pagination pagination-sm mb-0 shadow-sm">
                <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-filter.Page="@(Model.Page - 1)" asp-route-filter.IdCard="@Model.Filter.IdCard" asp-route-filter.Status="@Model.Filter.Status">
                        Anterior
                    </a>
                </li>
                
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-filter.Page="@i" asp-route-filter.IdCard="@Model.Filter.IdCard" asp-route-filter.Status="@Model.Filter.Status">
                            @i
                        </a>
                    </li>
                }

                <li class="page-item @(Model.HasNext ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-filter.Page="@(Model.Page + 1)" asp-route-filter.IdCard="@Model.Filter.IdCard" asp-route-filter.Status="@Model.Filter.Status">
                        Siguiente
                    </a>
                </li>
            </ul>
        </nav>
    }
</div>
