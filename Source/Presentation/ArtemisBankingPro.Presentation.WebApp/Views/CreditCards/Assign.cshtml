@using Artemis_Banking_Pro.Core.Application.ViewModels.CreditCards
@model ClientsForCreditCardAssignmentViewModel

@{
    ViewData["Title"] = "Asignar Tarjeta de Crédito - Seleccionar Cliente";
}

<div class="container mt-4 mb-5">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold" style="font-family: 'Montserrat', sans-serif; color: #0F172A;">
                <a asp-action="Index" class="text-decoration-none text-muted me-2" title="Volver al Listado">
                    <i class="bi bi-arrow-left-circle"></i>
                </a>
                Paso 1: Seleccionar Cliente
            </h2>
            <p class="text-muted mb-0">Seleccione el cliente al que se le asignará la tarjeta de crédito.</p>
        </div>
    </div>

    <!-- Promedio de Deuda -->
    <div class="alert shadow-sm border-0 d-flex align-items-center" style="background-color: #E2E8F0; color: #0F172A;">
        <i class="bi bi-info-circle-fill fs-4 me-3 text-primary"></i>
        <div>
            <h6 class="mb-0 fw-bold">Promedio de Deuda del Sistema</h6>
            <p class="mb-0 fs-5">RD$ @Model.AverageDebt.ToString("N2")</p>
        </div>
    </div>

    <!-- Búsqueda -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body bg-light">
            <form asp-action="Assign" method="get" class="row gx-3 gy-2 align-items-center">
                <div class="col-sm-6">
                    <label class="fw-bold" style="color: #0F172A;">Buscar Cliente por Cédula:</label>
                    <input asp-for="IdCard" class="form-control shadow-sm" placeholder="Ingrese cédula..." />
                </div>
                <div class="col-auto d-flex align-items-end" style="margin-top: 1.8rem;">
                    <button type="submit" class="btn btn-dark fw-bold shadow-sm">
                        <i class="bi bi-search me-1"></i> Buscar
                    </button>
                    @if (!string.IsNullOrEmpty(Model.IdCard))
                    {
                        <a asp-action="Assign" class="btn btn-outline-secondary ms-2 shadow-sm">Limpiar</a>
                    }
                </div>
            </form>
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="alert alert-warning shadow-sm mb-4"></div>
    }

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-0">
                <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-muted sticky-top" style="font-size: 0.85rem;">
                            <tr>
                                <th class="ps-4">CÉDULA</th>
                                <th>NOMBRE Y APELLIDO</th>
                                <th>CORREO ELECTRÓNICO</th>
                                <th class="text-end">MONTO TOTAL DE DEUDA</th>
                                <th class="text-end pe-4">ACCIÓN</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Clients == null || !Model.Clients.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-5 text-muted">
                                        No se encontraron clientes elegibles.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var client in Model.Clients)
                                {
                                    <tr>
                                        <td class="ps-4 fw-bold">@client.IdCard</td>
                                        <td>@client.FullName</td>
                                        <td>@client.Email</td>
                                        <td class="text-end text-danger fw-bold">RD$ @client.TotalDebtAmount.ToString("N2")</td>
                                        <td class="text-end pe-4">
                                            <form asp-action="SelectCustomer" method="post" class="m-0 p-0 d-inline">
                                                <input type="hidden" name="customerId" value="@client.Id" />
                                                <input type="hidden" name="fullNameCustomer" value="@client.FullName" />
                                                <button type="submit" class="btn btn-sm btn-outline-primary fw-bold shadow-sm px-3">
                                                    Seleccionar
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-start mt-4">
            <a asp-action="Index" class="btn btn-light fw-bold shadow-sm px-4 py-2">Volver atrás</a>
        </div>
</div>
