<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Artemis Banking Pro</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ArtemisBankingPro.Presentation.WebApp.styles.css" asp-append-version="true" />
</head>
<body style="background-color: #F8FAFC; overflow: hidden;">
    <div class="d-flex min-vh-100">
        <aside class="sidebar text-white d-flex flex-column shadow-lg" style="width: 240px; min-height: 100vh; background-color: #0F172A; z-index: 1000;">
            <div class="p-4 border-bottom border-secondary border-opacity-25 text-center">
                <a class="navbar-brand fw-bold text-white fs-4 text-decoration-none" style="font-family: 'Montserrat', sans-serif; letter-spacing: 2px;" asp-area="" asp-controller="Home" asp-action="Index">
                    ARTEMIS<span style="color: #0EA5E9;">.</span>
                </a>
            </div>
            
            <div class="flex-grow-1 p-3 pt-4">
                @{
                    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString() ?? "";
                }
                <ul class="nav flex-column gap-2">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        if (User.IsInRole("Administrador"))
                        {
                            <li class="nav-item">
                                <a class="nav-link rounded d-flex align-items-center py-2 px-3 fw-medium @GetActiveStyle(currentController, "Admin")" style="font-size: 0.9rem;" asp-area="" asp-controller="Admin" asp-action="Index">
                                    <i class="bi bi-grid-1x2 me-3 fs-5"></i> Home
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link rounded d-flex align-items-center py-2 px-3 fw-medium @GetActiveStyle(currentController, "Users")" style="font-size: 0.9rem;" asp-area="" asp-controller="Users" asp-action="Index">
                                    <i class="bi bi-people me-3 fs-5"></i> Gestión de usuarios
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link rounded d-flex align-items-center py-2 px-3 fw-medium @GetActiveStyle(currentController, "Loans")" style="font-size: 0.9rem;" asp-area="" asp-controller="Loans" asp-action="Index">
                                    <i class="bi bi-cash-coin me-3 fs-5"></i> Gestión de préstamos
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link rounded d-flex align-items-center py-2 px-3 fw-medium @GetActiveStyle(currentController, "CreditCards")" style="font-size: 0.9rem;" asp-area="" asp-controller="CreditCards" asp-action="Index">
                                    <i class="bi bi-credit-card me-3 fs-5"></i> Tarjetas de crédito
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link rounded d-flex align-items-center py-2 px-3 fw-medium @GetActiveStyle(currentController, "SavingsAccounts")" style="font-size: 0.9rem;" asp-area="" asp-controller="SavingsAccounts" asp-action="Index">
                                    <i class="bi bi-piggy-bank me-3 fs-5"></i> Cuentas de ahorro
                                </a>
                            </li>
                        }
                        else if (User.IsInRole("Cajero"))
                        {
                            <li class="nav-item">
                                <a class="nav-link rounded d-flex align-items-center py-2 px-3 fw-medium @(currentController == "Atm" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "bg-white bg-opacity-10 text-white" : "text-white opacity-75 sidebar-link")" style="font-size: 0.9rem;" asp-area="" asp-controller="Atm" asp-action="Index">
                                    <i class="bi bi-grid-1x2 me-3 fs-5"></i> Home
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link rounded d-flex align-items-center py-2 px-3 fw-medium @(currentController == "Atm" && ViewContext.RouteData.Values["Action"]?.ToString() == "Deposit" ? "bg-white bg-opacity-10 text-white" : "text-white opacity-75 sidebar-link")" style="font-size: 0.9rem;" asp-area="" asp-controller="Atm" asp-action="Deposit">
                                    <i class="bi bi-box-arrow-in-down me-3 fs-5"></i> Depósito
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link rounded d-flex align-items-center py-2 px-3 fw-medium @(currentController == "Atm" && ViewContext.RouteData.Values["Action"]?.ToString() == "Withdrawal" ? "bg-white bg-opacity-10 text-white" : "text-white opacity-75 sidebar-link")" style="font-size: 0.9rem;" asp-area="" asp-controller="Atm" asp-action="Withdrawal">
                                    <i class="bi bi-box-arrow-up me-3 fs-5"></i> Retiro
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link rounded d-flex align-items-center py-2 px-3 fw-medium @(currentController == "Atm" && ViewContext.RouteData.Values["Action"]?.ToString() == "CreditCardPayment" ? "bg-white bg-opacity-10 text-white" : "text-white opacity-75 sidebar-link")" style="font-size: 0.9rem;" asp-area="" asp-controller="Atm" asp-action="CreditCardPayment">
                                    <i class="bi bi-credit-card me-3 fs-5"></i> Pago a tarjeta
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link rounded d-flex align-items-center py-2 px-3 fw-medium @(currentController == "Atm" && ViewContext.RouteData.Values["Action"]?.ToString() == "LoanPayment" ? "bg-white bg-opacity-10 text-white" : "text-white opacity-75 sidebar-link")" style="font-size: 0.9rem;" asp-area="" asp-controller="Atm" asp-action="LoanPayment">
                                    <i class="bi bi-cash-coin me-3 fs-5"></i> Pago a préstamo
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link rounded d-flex align-items-center py-2 px-3 fw-medium @(currentController == "Atm" && ViewContext.RouteData.Values["Action"]?.ToString() == "ThirdPartyTransfer" ? "bg-white bg-opacity-10 text-white" : "text-white opacity-75 sidebar-link")" style="font-size: 0.9rem;" asp-area="" asp-controller="Atm" asp-action="ThirdPartyTransfer">
                                    <i class="bi bi-arrow-left-right me-3 fs-5"></i> Cuentas de terceros
                                </a>
                            </li>
                        }
                        else if (User.IsInRole("Cliente"))
                        {
                            <li class="nav-item">
                                <a class="nav-link rounded d-flex align-items-center py-2 px-3 fw-medium @GetActiveStyle(currentController, "Customer")" style="font-size: 0.9rem;" asp-area="" asp-controller="Customer" asp-action="Index">
                                    <i class="bi bi-grid-1x2 me-3 fs-5"></i> Mis Productos
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link rounded d-flex align-items-center py-2 px-3 fw-medium @GetActiveStyle(currentController, "Beneficiaries")" style="font-size: 0.9rem;" asp-area="" asp-controller="Beneficiaries" asp-action="Index">
                                    <i class="bi bi-people me-3 fs-5"></i> Beneficiarios
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link rounded d-flex align-items-center py-2 px-3 fw-medium @(currentController == "Transactions" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "bg-white bg-opacity-10 text-white" : "text-white opacity-75 sidebar-link")" style="font-size: 0.9rem;" asp-area="" asp-controller="Transactions" asp-action="Index">
                                    <i class="bi bi-wallet2 me-3 fs-5"></i> Pagos y Transferencias
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link rounded d-flex align-items-center py-2 px-3 fw-medium @(currentController == "Transactions" && ViewContext.RouteData.Values["Action"]?.ToString() == "Express" ? "bg-white bg-opacity-10 text-white" : "text-white opacity-75 sidebar-link")" style="font-size: 0.9rem;" asp-area="" asp-controller="Transactions" asp-action="Express">
                                    <i class="bi bi-arrow-left-right me-3 fs-5"></i> Transferencia Exprés
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link rounded d-flex align-items-center py-2 px-3 fw-medium @GetActiveStyle(currentController, "CashAdvance")" style="font-size: 0.9rem;" asp-area="" asp-controller="CashAdvance" asp-action="Index">
                                    <i class="bi bi-cash me-3 fs-5"></i> Avances de Efectivo
                                </a>
                            </li>
                        }
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link rounded d-flex align-items-center py-2 px-3 fw-medium @(currentController == "Home" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "bg-white bg-opacity-10 text-white" : "text-white opacity-75 sidebar-link")" style="font-size: 0.9rem;" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-3 fs-5"></i> Inicio
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link rounded d-flex align-items-center py-2 px-3 fw-medium @(currentController == "Home" && ViewContext.RouteData.Values["Action"]?.ToString() == "Privacy" ? "bg-white bg-opacity-10 text-white" : "text-white opacity-75 sidebar-link")" style="font-size: 0.9rem;" asp-area="" asp-controller="Home" asp-action="Privacy">
                                <i class="bi bi-shield-lock me-3 fs-5"></i> Privacidad
                            </a>
                        </li>
                    }
                </ul>
            </div>
            
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <div class="p-3 border-top border-secondary border-opacity-25 mt-auto dropdown dropup">
                    <a href="#" class="d-flex align-items-center text-white text-decoration-none dropdown-toggle p-2 rounded" id="dropdownUser" data-bs-toggle="dropdown" aria-expanded="false" style="transition: background-color 0.2s;" onmouseover="this.style.backgroundColor='rgba(255,255,255,0.05)'" onmouseout="this.style.backgroundColor='transparent'">
                        <div class="bg-primary rounded-circle d-flex justify-content-center align-items-center text-white shadow-sm me-3 flex-shrink-0" style="width: 40px; height: 40px; font-weight: bold; background-color: #4472C4 !important;">
                            @User.Identity.Name?.Substring(0, 1).ToUpper()
                        </div>
                        <div class="text-truncate me-auto">
                            <div class="fw-bold text-white fs-6">@User.Identity.Name</div>
                            <div class="text-white opacity-50 small">En línea</div>
                        </div>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-dark text-small shadow border-0 mb-2 w-100" aria-labelledby="dropdownUser" style="background-color: #1E293B; border-radius: 8px;">
                        <li>
                            <a class="dropdown-item text-danger fw-bold d-flex align-items-center py-2" asp-area="" asp-controller="Account" asp-action="Logout">
                                <i class="bi bi-box-arrow-right me-3 fs-5"></i> Cerrar sesión
                            </a>
                        </li>
                    </ul>
                </div>
            }
        </aside>

        <main role="main" class="flex-grow-1 w-100" style="background-color: #F8FAFC; height: 100vh; overflow-y: auto;">
            <div class="container-fluid p-3 p-md-4">
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@functions {
    public string GetActiveStyle(string currentController, string targetController)
    {
        return currentController == targetController 
            ? "bg-white bg-opacity-10 text-white" 
            : "text-white opacity-75 sidebar-link";
    }
}
