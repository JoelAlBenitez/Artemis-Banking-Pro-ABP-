@using Artemis_Banking_Pro.Core.Application.ViewModels.Transactions
@model ConfirmCashAdvanceViewModel
@{
    ViewData["Title"] = "Confirmar Avance de Efectivo";
}

<div class="container-fluid py-4" style="font-family: 'Montserrat', sans-serif;">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-10 col-xl-9">
            <div class="card border-0 shadow-sm rounded-2 overflow-hidden">
                <div class="card-header bg-white text-dark p-4 border-bottom">
                    <h3 class="fw-bold mb-1">Confirmar Avance</h3>
                    <p class="mb-0 text-muted small fw-bold">Verifique la información antes de procesar el avance de efectivo.</p>
                </div>
                
                <div class="card-body p-4 bg-white text-center">
                    <h4 class="fw-bold mb-4 fs-5">¿Está seguro que desea realizar este avance de efectivo?</h4>
                    
                    <div class="bg-light rounded-2 p-4 text-start mb-4 shadow-sm border border-secondary border-opacity-10">
                        <div class="row g-4">
                            <div class="col-sm-6">
                                <p class="mb-1 text-secondary small fw-bold text-uppercase" style="letter-spacing: 1px;">Tarjeta Origen</p>
                                <p class="mb-0 font-monospace fs-5 fw-bold text-dark">@Model.SourceCardNumber</p>
                            </div>

                            <div class="col-sm-6">
                                <p class="mb-1 text-secondary small fw-bold text-uppercase" style="letter-spacing: 1px;">Cuenta Destino</p>
                                <p class="mb-0 font-monospace fs-5 fw-bold text-dark">@Model.DestinationAccountNumber</p>
                            </div>

                            <div class="col-12 border-top pt-3 mt-3">
                                <p class="mb-1 text-secondary small fw-bold text-uppercase" style="letter-spacing: 1px;">Monto Solicitado</p>
                                <p class="mb-0 font-monospace fs-4 fw-bold text-success">RD$ @Model.Amount.ToString("N2")</p>
                                
                                <div class="mt-2 pt-2 border-top border-opacity-50">
                                    <div class="d-flex justify-content-between">
                                        <span class="text-muted small">Interés (6.25%):</span>
                                        <span class="text-dark small fw-bold">RD$ @((Model.Amount * 0.0625m).ToString("N2"))</span>
                                    </div>
                                    <div class="d-flex justify-content-between mt-1">
                                        <span class="text-info small fw-bold">Total a Cargar:</span>
                                        <span class="text-info small fw-bold">RD$ @((Model.Amount + (Model.Amount * 0.0625m)).ToString("N2"))</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <form asp-controller="CashAdvance" asp-action="ExecuteCashAdvance" method="post">
                        <input type="hidden" asp-for="CreditCardId" />
                        <input type="hidden" asp-for="SavingsAccountId" />
                        <input type="hidden" asp-for="SourceCardNumber" />
                        <input type="hidden" asp-for="DestinationAccountNumber" />
                        <input type="hidden" asp-for="Amount" />

                        <div class="d-flex gap-3 justify-content-center">
                            <a asp-controller="CashAdvance" asp-action="Index" class="btn btn-light rounded-2 fw-bold px-5 shadow-sm text-secondary">
                                Cancelar
                            </a>
                            <button type="submit" class="btn btn-dark rounded-2 fw-bold px-5 shadow-sm text-white">
                                Confirmar Avance
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>