@using Artemis_Banking_Pro.Core.Application.ViewModels.Transactions
@model CashAdvanceViewModel
@{
    ViewData["Title"] = "Avance de Efectivo";
}

<div class="container-fluid py-5" style="font-family: 'Montserrat', sans-serif;">
    <div class="row justify-content-center">
        <div class="col-md-12 col-lg-10 col-xl-8">
            
            <div class="mb-4 text-center">
                <h2 class="fw-bold mb-2" style="color: #0F172A;">
                    <i class="bi bi-cash-stack text-success me-2"></i> Avance de Efectivo
                </h2>
                <p class="text-muted mb-0 fs-5">Transfiere fondos desde tu tarjeta de crédito a tu cuenta de ahorro.</p>
            </div>

            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-4 p-md-5">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger shadow-sm border-0 rounded-3 mb-4">
                            <i class="bi bi-exclamation-circle-fill me-2"></i>
                            <strong>¡Atención!</strong>
                            <div asp-validation-summary="All" class="mt-2 mb-0 small"></div>
                        </div>
                    }

                    @if (Model.AvailableCards == null || !Model.AvailableCards.Any())
                    {
                        <div class="alert alert-warning border-0 rounded-3 shadow-sm p-4 text-center">
                            <i class="bi bi-exclamation-triangle-fill fs-1 text-warning mb-3 d-block"></i>
                            <h5 class="fw-bold">Sin tarjetas disponibles</h5>
                            <p class="mb-0">No posees tarjetas de crédito activas para realizar avances.</p>
                        </div>
                    }
                    else if (Model.AvailableAccounts == null || !Model.AvailableAccounts.Any())
                    {
                        <div class="alert alert-warning border-0 rounded-3 shadow-sm p-4 text-center">
                            <i class="bi bi-exclamation-triangle-fill fs-1 text-warning mb-3 d-block"></i>
                            <h5 class="fw-bold">Sin cuentas disponibles</h5>
                            <p class="mb-0">No posees cuentas de ahorro activas para recibir el avance.</p>
                        </div>
                    }
                    else
                    {
                        <form asp-controller="CashAdvance" asp-action="Index" method="post" id="cashAdvanceForm">
                            <div class="row g-4 mb-5">
                                <div class="col-md-6">
                                    <label asp-for="CreditCardId" class="form-label fw-bold text-secondary">Tarjeta de crédito origen <span class="text-danger">*</span></label>
                                    <select asp-for="CreditCardId" class="form-select" id="cardSelect" onchange="updateAvailableCredit()">
                                        <option value="">-- Seleccione una tarjeta --</option>
                                        @foreach(var card in Model.AvailableCards)
                                        {
                                            <option value="@card.Id" data-credit="@(card.CreditLimit - card.OwedAmount)">**** @card.LastFourDigits (Disponible: RD$ @((card.CreditLimit - card.OwedAmount).ToString("N2")))</option>
                                        }
                                    </select>
                                    <span asp-validation-for="CreditCardId" class="text-danger small mt-1 d-block"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="SavingsAccountId" class="form-label fw-bold text-secondary">Cuenta de ahorro destino <span class="text-danger">*</span></label>
                                    <select asp-for="SavingsAccountId" class="form-select">
                                        <option value="">-- Seleccione cuenta a depositar --</option>
                                        @foreach(var account in Model.AvailableAccounts)
                                        {
                                            <option value="@account.Id">@account.AccountNumber - RD$ @account.Balance.ToString("N2")</option>
                                        }
                                    </select>
                                    <span asp-validation-for="SavingsAccountId" class="text-danger small mt-1 d-block"></span>
                                </div>

                                <div class="col-12">
                                    <label asp-for="Amount" class="form-label fw-bold text-secondary">Monto del avance de efectivo <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light text-secondary fw-bold">RD$</span>
                                        <input asp-for="Amount" type="number" step="0.01" class="form-control fw-bold" placeholder="0.00" autocomplete="off" oninput="calculateInterest()" />
                                    </div>
                                    <span asp-validation-for="Amount" class="text-danger small mt-1 d-block"></span>
                                    
                                    <div class="mt-3 pt-3 border-top">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="text-muted small"><i class="bi bi-info-circle me-1"></i> Interés (6.25%):</span>
                                            <span class="text-dark fw-bold small font-monospace" id="interestDisplay">RD$ 0.00</span>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="text-info fw-medium small"><i class="bi bi-calculator me-1"></i> Total a cargar a la tarjeta:</span>
                                            <span class="text-info fw-bold small font-monospace" id="totalDisplay">RD$ 0.00</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex gap-3 justify-content-end pt-4 border-top">
                                <a asp-controller="Customer" asp-action="Index" class="btn btn-light px-4">Cancelar</a>
                                <button type="submit" class="btn btn-dark px-5">Continuar</button>
                            </div>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function calculateInterest() {
            var amountInput = document.getElementById('Amount').value;
            var amount = parseFloat(amountInput) || 0;
            
            var interest = amount * 0.0625;
            var total = amount + interest;
            
            document.getElementById('interestDisplay').innerText = 'RD$ ' + interest.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});
            document.getElementById('totalDisplay').innerText = 'RD$ ' + total.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});
        }
    </script>
}
