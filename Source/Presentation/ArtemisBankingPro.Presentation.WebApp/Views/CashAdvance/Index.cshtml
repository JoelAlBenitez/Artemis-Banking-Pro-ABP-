@using Artemis_Banking_Pro.Core.Application.ViewModels.Transactions
@model CashAdvanceViewModel
@{
    ViewData["Title"] = "Avance de Efectivo";
}

<div class="container-fluid py-4" style="font-family: 'Montserrat', sans-serif;">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-lg rounded-2 overflow-hidden">
                <div class="card-header bg-dark text-white p-4 border-0">
                    <h3 class="fw-bold mb-1"><i class="bi bi-cash-stack me-2 text-success"></i> Avance de Efectivo</h3>
                    <p class="mb-0 opacity-75 small">Transfiere fondos desde tu tarjeta de crédito a tu cuenta de ahorro.</p>
                </div>
                
                <div class="card-body p-4 p-md-5">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger shadow-sm border-0 rounded-2 mb-4">
                            <i class="bi bi-exclamation-circle-fill me-2"></i>
                            <strong>¡Atención!</strong>
                            <div asp-validation-summary="All" class="mt-2 mb-0 small"></div>
                        </div>
                    }

                    @if (Model.AvailableCards == null || !Model.AvailableCards.Any())
                    {
                        <div class="alert alert-warning border-0 rounded-2 shadow-sm p-4 text-center">
                            <i class="bi bi-exclamation-triangle-fill fs-1 text-warning mb-3 d-block"></i>
                            <h5 class="fw-bold">Sin tarjetas disponibles</h5>
                            <p class="mb-0">No posees tarjetas de crédito activas para realizar avances.</p>
                        </div>
                    }
                    else if (Model.AvailableAccounts == null || !Model.AvailableAccounts.Any())
                    {
                        <div class="alert alert-warning border-0 rounded-2 shadow-sm p-4 text-center">
                            <i class="bi bi-exclamation-triangle-fill fs-1 text-warning mb-3 d-block"></i>
                            <h5 class="fw-bold">Sin cuentas disponibles</h5>
                            <p class="mb-0">No posees cuentas de ahorro activas para recibir el avance.</p>
                        </div>
                    }
                    else
                    {
                        <form asp-controller="CashAdvance" asp-action="Index" method="post" id="cashAdvanceForm">
                            
                            <div class="mb-4">
                                <label asp-for="CreditCardId" class="form-label fw-bold text-secondary">Tarjeta de crédito origen <span class="text-danger">*</span></label>
                                <select asp-for="CreditCardId" class="form-select form-select-lg border-0 bg-light shadow-sm rounded-2 font-monospace" id="cardSelect" onchange="updateAvailableCredit()">
                                    <option value="">Seleccione una tarjeta</option>
                                    @foreach(var card in Model.AvailableCards)
                                    {
                                        <option value="@card.Id" data-credit="@(card.CreditLimit - card.OwedAmount)">**** @card.LastFourDigits (Disponible: RD$ @((card.CreditLimit - card.OwedAmount).ToString("N2")))</option>
                                    }
                                </select>
                                <span asp-validation-for="CreditCardId" class="text-danger small mt-2 d-block fw-bold"></span>
                            </div>

                            <div class="mb-4">
                                <label asp-for="SavingsAccountId" class="form-label fw-bold text-secondary">Cuenta de ahorro destino <span class="text-danger">*</span></label>
                                <select asp-for="SavingsAccountId" class="form-select form-select-lg border-0 bg-light shadow-sm rounded-2 font-monospace">
                                    <option value="">Seleccione cuenta a depositar</option>
                                    @foreach(var account in Model.AvailableAccounts)
                                    {
                                        <option value="@account.Id">@account.AccountNumber - (RD$ @account.Balance.ToString("N2"))</option>
                                    }
                                </select>
                                <span asp-validation-for="SavingsAccountId" class="text-danger small mt-2 d-block fw-bold"></span>
                            </div>

                            <div class="mb-5">
                                <label asp-for="Amount" class="form-label fw-bold text-secondary">Monto del avance de efectivo <span class="text-danger">*</span></label>
                                <div class="input-group input-group-lg shadow-sm rounded-2 overflow-hidden">
                                    <span class="input-group-text bg-light border-0 text-success fw-bold">RD$</span>
                                    <input asp-for="Amount" type="number" step="0.01" class="form-control border-0 bg-light font-monospace text-dark fw-bold" placeholder="0.00" autocomplete="off" oninput="calculateInterest()" />
                                </div>
                                <span asp-validation-for="Amount" class="text-danger small mt-2 d-block fw-bold"></span>
                                
                                <div class="alert alert-secondary mt-3 mb-0 rounded-3 border-0 d-flex justify-content-between align-items-center">
                                    <span class="small fw-bold text-secondary"><i class="bi bi-info-circle me-1"></i> Interés (6.25%):</span>
                                    <span class="small fw-bold text-dark font-monospace" id="interestDisplay">RD$ 0.00</span>
                                </div>
                                <div class="alert alert-info mt-2 mb-0 rounded-3 border-0 d-flex justify-content-between align-items-center">
                                    <span class="small fw-bold text-info"><i class="bi bi-calculator me-1"></i> Total a cargar:</span>
                                    <span class="small fw-bold text-dark font-monospace" id="totalDisplay">RD$ 0.00</span>
                                </div>
                            </div>

                            <div class="d-flex gap-3 justify-content-end border-top border-secondary border-opacity-25 pt-4">
                                <a asp-controller="Customer" asp-action="Index" class="btn btn-light rounded-2 fw-bold px-4 shadow-sm text-secondary">
                                    Cancelar
                                </a>
                                <button type="submit" class="btn btn-dark rounded-2 fw-bold px-5 shadow-sm">
                                    Realizar avance
                                </button>
                            </div>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function calculateInterest() {
            var amountInput = document.getElementById('Amount').value;
            var amount = parseFloat(amountInput) || 0;
            
            var interest = amount * 0.0625;
            var total = amount + interest;
            
            document.getElementById('interestDisplay').innerText = 'RD$ ' + interest.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});
            document.getElementById('totalDisplay').innerText = 'RD$ ' + total.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});
        }
    </script>
}
