@model ArtemisBankingPro.Core.Application.ViewModels.Atm.ConfirmCreditCardPaymentViewModel
@{
    ViewData["Title"] = "Confirmar Pago a Tarjeta";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-warning">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0">Confirmar Operación</h4>
                </div>
                <div class="card-body text-center">
                    <p class="lead mb-4">¿Está seguro que desea realizar este pago?</p>
                    
                    <ul class="list-group list-group-flush text-start mb-4">
                        <li class="list-group-item"><strong>Titular de la cuenta origen:</strong> @Model.AccountOwnerName</li>
                        <li class="list-group-item"><strong>Número de cuenta origen:</strong> @Model.SourceAccountNumber</li>
                        <li class="list-group-item"><strong>Titular de la tarjeta:</strong> @Model.CreditCardOwnerName</li>
                        <li class="list-group-item"><strong>Tarjeta destino:</strong> **** @Model.CardLastFourDigits</li>
                        <li class="list-group-item"><strong>Monto ingresado:</strong> RD$ @Model.EnteredAmount</li>
                        <li class="list-group-item"><strong>Monto efectivo a pagar:</strong> RD$ @Model.EffectiveAmount</li>
                    </ul>

                    <form asp-action="ExecuteCreditCardPayment" method="post" class="d-flex justify-content-between">
                        <input type="hidden" asp-for="SourceAccountNumber" />
                        <input type="hidden" asp-for="CreditCardNumber" />
                        <input type="hidden" asp-for="CardLastFourDigits" />
                        <input type="hidden" asp-for="EffectiveAmount" />
                        
                        <a asp-controller="Home" asp-action="Index" class="btn btn-secondary px-4">Cancelar</a>
                        <button type="submit" class="btn btn-success px-4">Confirmar</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
