@using ArtemisBankingPro.Core.Application.ViewModels.Atm
@model ConfirmWithdrawalViewModel
@{
    ViewData["Title"] = "Cajero - Confirmar Retiro";
}

<div class="container-fluid py-4" style="font-family: 'Montserrat', sans-serif;">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6 col-xl-5">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-white text-dark p-4 border-bottom">
                    <h3 class="fw-bold mb-1"><i class="bi bi-shield-exclamation me-2"></i> Confirmar Retiro</h3>
                    <p class="mb-0 opacity-75 small fw-bold">Verifique la información antes de aplicar la transacción.</p>
                </div>
                
                <div class="card-body p-4 p-md-5 bg-white text-center">
                    <i class="bi bi-box-arrow-up text-danger opacity-75 mb-3" style="font-size: 3.5rem;"></i>
                    <h4 class="fw-bold mb-4">¿Está seguro que desea realizar este retiro?</h4>
                    
                    <div class="bg-light rounded-4 p-4 text-start mb-4 shadow-sm border border-secondary border-opacity-10">
                        <div class="mb-3 border-bottom pb-3">
                            <p class="mb-1 text-secondary small fw-bold text-uppercase" style="letter-spacing: 1px;">Titular de la cuenta</p>
                            <p class="mb-0 fs-5 fw-bold text-dark"><i class="bi bi-person-fill text-muted me-2"></i>@Model.AccountOwnerName</p>
                        </div>

                        <div class="mb-3 border-bottom pb-3">
                            <p class="mb-1 text-secondary small fw-bold text-uppercase" style="letter-spacing: 1px;">Cuenta Origen</p>
                            <p class="mb-0 font-monospace fs-5 fw-bold text-primary"><i class="bi bi-hash text-muted me-1"></i>@Model.OriginAccountNumber</p>
                        </div>

                        <div>
                            <p class="mb-1 text-secondary small fw-bold text-uppercase" style="letter-spacing: 1px;">Monto a Retirar</p>
                            <p class="mb-0 font-monospace fs-4 fw-bold text-danger"><i class="bi bi-cash-stack text-muted me-2"></i>RD$ @Model.Amount.ToString("N2")</p>
                        </div>
                    </div>

                    <form asp-controller="Atm" asp-action="ConfirmWithdrawal" method="post">
                        <input type="hidden" asp-for="OriginAccountNumber" />
                        <input type="hidden" asp-for="AccountOwnerName" />
                        <input type="hidden" asp-for="Amount" />

                        <div class="d-flex gap-3 justify-content-center">
                            <a asp-controller="Atm" asp-action="Index" class="btn btn-light rounded-pill fw-bold px-5 shadow-sm text-secondary">
                                Cancelar
                            </a>
                            <button type="submit" class="btn btn-danger rounded-pill fw-bold px-5 shadow-sm text-white">
                                Confirmar Retiro <i class="bi bi-check2-circle ms-2"></i>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
