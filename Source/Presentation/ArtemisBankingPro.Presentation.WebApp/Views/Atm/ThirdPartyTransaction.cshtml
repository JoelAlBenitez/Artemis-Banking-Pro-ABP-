@model ArtemisBankingPro.Core.Application.ViewModels.Atm.ThirdPartyTransactionViewModel
@{
    ViewData["Title"] = "Transacción a cuenta de terceros";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Transacción a cuenta de terceros</h4>
                </div>
                <div class="card-body">
                    <form asp-action="ThirdPartyTransaction" method="post">
                        <div class="mb-3">
                            <label asp-for="SourceAccountNumber" class="form-label">Número de cuenta origen</label>
                            <input asp-for="SourceAccountNumber" class="form-control" placeholder="Ingrese el número de cuenta" />
                            <span asp-validation-for="SourceAccountNumber" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="DestinationAccountNumber" class="form-label">Número de cuenta destino</label>
                            <input asp-for="DestinationAccountNumber" class="form-control" placeholder="Ingrese el número de cuenta" />
                            <span asp-validation-for="DestinationAccountNumber" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Amount" class="form-label">Monto de la transacción</label>
                            <input asp-for="Amount" type="number" step="0.01" class="form-control" placeholder="0.00" />
                            <span asp-validation-for="Amount" class="text-danger"></span>
                        </div>
                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-primary">Realizar transacción</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
