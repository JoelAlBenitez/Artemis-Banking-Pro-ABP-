@model ArtemisBankingPro.Core.Application.ViewModels.Atm.DepositViewModel
@{
    ViewData["Title"] = "Depósito a Cuenta de Ahorro";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header bg-success text-white text-center py-3">
                    <h4 class="mb-0"><i class="bi bi-box-arrow-in-down me-2"></i> Depósito a Cuenta de Ahorro</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Deposit" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="DestinationAccountNumber" class="form-label fw-semibold"></label>
                            <input asp-for="DestinationAccountNumber" class="form-control form-control-lg" placeholder="Ej. 20250001" />
                            <span asp-validation-for="DestinationAccountNumber" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Amount" class="form-label fw-semibold"></label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text">RD$</span>
                                <input asp-for="Amount" class="form-control" placeholder="0.00" type="number" step="0.01" min="0.01" />
                            </div>
                            <span asp-validation-for="Amount" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="bi bi-check-circle me-2"></i> Realizar depósito
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i> Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
