@model ArtemisBankingPro.Core.Application.ViewModels.Atm.DepositViewModel

@{
    ViewData["Title"] = "Make a Deposit";
    Layout = "~/Views/Shared/_CajeroLayout.cshtml";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Make a Deposit</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Deposit" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        
                        <div class="form-group mb-3">
                            <label asp-for="DestinationAccountNumber" class="form-label">Destination Account Number</label>
                            <input asp-for="DestinationAccountNumber" class="form-control" placeholder="Enter account number" />
                            <span asp-validation-for="DestinationAccountNumber" class="text-danger"></span>
                        </div>
                        
                        <div class="form-group mb-4">
                            <label asp-for="Amount" class="form-label">Amount to Deposit</label>
                            <input asp-for="Amount" class="form-control" type="number" step="0.01" min="0.01" />
                            <span asp-validation-for="Amount" class="text-danger"></span>
                        </div>
                        
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">Realizar depósito</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
