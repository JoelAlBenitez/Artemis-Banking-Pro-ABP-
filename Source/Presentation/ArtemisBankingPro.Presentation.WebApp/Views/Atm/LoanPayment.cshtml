@using ArtemisBankingPro.Core.Application.ViewModels.Atm
@model LoanPaymentViewModel
@{
    ViewData["Title"] = "Cajero - Pago a Préstamo";
}

<div class="container-fluid py-5" style="font-family: 'Montserrat', sans-serif;">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8 col-xl-6">
            
            <div class="mb-4 text-center">
                <h2 class="fw-bold mb-2" style="color: #0F172A;">
                    <i class="bi bi-cash-coin text-success me-2"></i> Pago a Préstamo
                </h2>
                <p class="text-muted mb-0 fs-5">Abonar cuotas a un préstamo con cargo a una cuenta de ahorro.</p>
            </div>

            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-4 p-md-5">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger shadow-sm border-0 rounded-3 mb-4">
                            <i class="bi bi-exclamation-circle-fill me-2"></i>
                            <strong>¡Atención!</strong>
                            <div asp-validation-summary="All" class="mt-2 mb-0 small"></div>
                        </div>
                    }

                    <form asp-controller="Atm" asp-action="LoanPayment" method="post">
                        
                        <div class="mb-4">
                            <label asp-for="OriginAccountNumber" class="form-label fw-bold text-secondary">Número de cuenta origen <span class="text-danger">*</span></label>
                            <input asp-for="OriginAccountNumber" type="text" class="form-control form-control-lg" placeholder="Ej: 123456789" autocomplete="off" />
                            <span asp-validation-for="OriginAccountNumber" class="text-danger small mt-1 d-block"></span>
                            <div class="form-text small text-muted">Cuenta desde donde se descontará el dinero.</div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="LoanNumber" class="form-label fw-bold text-secondary">Número del préstamo <span class="text-danger">*</span></label>
                            <input asp-for="LoanNumber" type="text" class="form-control form-control-lg" placeholder="Ej: 987654321" autocomplete="off" />
                            <span asp-validation-for="LoanNumber" class="text-danger small mt-1 d-block"></span>
                            <div class="form-text small text-muted">Ingrese los 9 dígitos del préstamo a pagar.</div>
                        </div>

                        <div class="mb-5">
                            <label asp-for="Amount" class="form-label fw-bold text-secondary">Monto a pagar <span class="text-danger">*</span></label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text bg-light text-secondary fw-bold">RD$</span>
                                <input asp-for="Amount" type="number" step="0.01" class="form-control form-control-lg fw-bold" placeholder="0.00" autocomplete="off" />
                            </div>
                            <span asp-validation-for="Amount" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="d-flex gap-3 justify-content-end pt-4 mt-2 border-top">
                            <a asp-controller="Atm" asp-action="Index" class="btn btn-light btn-lg px-4">Cancelar</a>
                            <button type="submit" class="btn btn-dark btn-lg px-5">Siguiente</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
