@using ArtemisBankingPro.Core.Application.ViewModels.Atm
@model ConfirmDepositViewModel
@{
    ViewData["Title"] = "Cajero - Confirmar Depósito";
}

<div class="container-fluid py-4" style="font-family: 'Montserrat', sans-serif;">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-5 col-xl-5">
            <div class="card border-0 shadow-lg rounded-2 overflow-hidden">
                <div class="card-header bg-white text-dark p-4 border-bottom">
                    <h3 class="fw-bold mb-1">Confirmar Depósito</h3>
                    <p class="mb-0 opacity-75 small fw-bold">Verifique la información antes de aplicar la transacción.</p>
                </div>
                
                <div class="card-body p-4 p-4 bg-white text-center">
                    <i class="bi bi-box-arrow-in-down text-warning opacity-75 mb-3" style="font-size: 3.5rem;"></i>
                    <h4 class="fw-bold mb-4">¿Está seguro que desea realizar este depósito?</h4>
                    
                    <div class="bg-light rounded-2 p-4 text-start mb-4 shadow-sm border border-secondary border-opacity-10">
                        <div class="mb-3 border-bottom pb-3">
                            <p class="mb-1 text-secondary small fw-bold text-uppercase" style="letter-spacing: 1px;">Titular de la cuenta</p>
                            <p class="mb-0 fs-5 fw-bold text-dark"><i class="bi bi-person-fill text-muted me-2"></i>@Model.AccountOwnerName</p>
                        </div>

                        <div class="mb-3 border-bottom pb-3">
                            <p class="mb-1 text-secondary small fw-bold text-uppercase" style="letter-spacing: 1px;">Cuenta Destino</p>
                            <p class="mb-0  fs-5 fw-bold text-primary"><i class="bi bi-hash text-muted me-1"></i>@Model.DestinationAccountNumber</p>
                        </div>

                        <div>
                            <p class="mb-1 text-secondary small fw-bold text-uppercase" style="letter-spacing: 1px;">Monto a Depositar</p>
                            <p class="mb-0  fs-4 fw-bold text-success"><i class="bi bi-cash-stack text-muted me-2"></i>RD$ @Model.Amount.ToString("N2")</p>
                        </div>
                    </div>

                    <form asp-controller="Atm" asp-action="ConfirmDeposit" method="post">
                        <input type="hidden" asp-for="DestinationAccountNumber" />
                        <input type="hidden" asp-for="AccountOwnerName" />
                        <input type="hidden" asp-for="Amount" />

                        <div class="d-flex gap-3 justify-content-center">
                            <a asp-controller="Atm" asp-action="Index" class="btn btn-light rounded-2 fw-bold px-5 shadow-sm text-secondary">
                                Cancelar
                            </a>
                            <button type="submit" class="btn btn-warning rounded-2 fw-bold px-5 shadow-sm text-dark">
                                Confirmar Depósito 
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>