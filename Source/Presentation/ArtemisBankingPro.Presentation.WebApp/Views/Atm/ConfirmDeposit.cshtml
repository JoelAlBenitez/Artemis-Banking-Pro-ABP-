@model ArtemisBankingPro.Core.Application.ViewModels.Atm.DepositConfirmationViewModel

@{
    ViewData["Title"] = "Confirm Deposit";
    Layout = "~/Views/Shared/_CajeroLayout.cshtml";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-info">
                <div class="card-header bg-info text-white">
                    <h4 class="mb-0">Confirm Deposit Details</h4>
                </div>
                <div class="card-body">
                    <p class="lead">Are you sure you want to make this deposit?</p>
                    <table class="table table-bordered mt-3">
                        <tbody>
                            <tr>
                                <th>Account Holder</th>
                                <td>@Model.AccountHolderName</td>
                            </tr>
                            <tr>
                                <th>Destination Account Number</th>
                                <td>@Model.DestinationAccountNumber</td>
                            </tr>
                            <tr>
                                <th>Amount to Deposit</th>
                                <td>@Model.Amount.ToString("C")</td>
                            </tr>
                        </tbody>
                    </table>
                    
                    <form asp-action="ConfirmDeposit" method="post">
                        <input type="hidden" asp-for="DestinationAccountNumber" />
                        <input type="hidden" asp-for="Amount" />
                        <input type="hidden" asp-for="AccountHolderName" />
                        
                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-success">Confirmar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
