@using ArtemisBankingPro.Core.Application.ViewModels.Atm
@model LoanPaymentConfirmationViewModel
@{
    ViewData["Title"] = "Cajero - Confirmar Pago a Préstamo";
}

<div class="container-fluid py-4" style="font-family: 'Montserrat', sans-serif;">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-5 col-xl-5">
            <div class="card border-0 shadow-lg rounded-2 overflow-hidden">
                <div class="card-header bg-white text-dark p-4 border-bottom">
                    <h3 class="fw-bold mb-1">Confirmar Pago a Préstamo</h3>
                    <p class="mb-0 opacity-75 small fw-bold">Verifique la información antes de aplicar la transacción.</p>
                </div>
                
                <div class="card-body p-4 p-4 bg-white text-center">
                    <i class="bi bi-cash-stack text-success opacity-75 mb-3" style="font-size: 3.5rem;"></i>
                    <h4 class="fw-bold mb-4">¿Está seguro que desea realizar este pago?</h4>
                    
                    @if (Model.Amount > Model.EffectiveAmount)
                    {
                        <div class="alert alert-warning border-0 rounded-2 shadow-sm mb-4 text-start">
                            <i class="bi bi-info-circle-fill me-2"></i> <strong>Nota:</strong> El monto ingresado (RD$ @Model.Amount.ToString("N2")) excede la deuda pendiente. Solo se descontará el monto real de la deuda.
                        </div>
                    }

                    <div class="bg-light rounded-2 p-4 text-start mb-4 shadow-sm border border-secondary border-opacity-10">
                        <div class="row g-3 mb-3 border-bottom pb-3">
                            <div class="col-6">
                                <p class="mb-1 text-secondary small fw-bold text-uppercase" style="letter-spacing: 1px;">Cuenta Origen</p>
                                <p class="mb-0  fs-6 fw-bold text-dark"><i class="bi bi-hash text-muted me-1"></i>@Model.OriginAccountNumber</p>
                            </div>
                            <div class="col-6 text-end">
                                <p class="mb-1 text-secondary small fw-bold text-uppercase" style="letter-spacing: 1px;">Titular Cuenta</p>
                                <p class="mb-0 fs-5 fw-bold text-dark text-truncate">@Model.OriginAccountHolderName</p>
                            </div>

                        <div class="row g-3 mb-3 border-bottom pb-3">
                            <div class="col-6">
                                <p class="mb-1 text-secondary small fw-bold text-uppercase" style="letter-spacing: 1px;">Préstamo Destino</p>
                                <p class="mb-0  fs-6 fw-bold text-primary"><i class="bi bi-hash text-muted me-1"></i>@Model.LoanNumber</p>
                            </div>

                            <div class="col-sm-6 border-top pt-3">
                                <p class="mb-1 text-secondary small fw-bold text-uppercase" style="letter-spacing: 1px;">Titular Préstamo</p>
                                <p class="mb-0 fs-5 fw-bold text-dark text-truncate">@Model.LoanHolderName</p>
                            </div>

                        <div>
                            <p class="mb-1 text-secondary small fw-bold text-uppercase" style="letter-spacing: 1px;">Monto Efectivo a Pagar</p>
                            <p class="mb-0  fs-4 fw-bold text-success"><i class="bi bi-cash text-muted me-2"></i>RD$ @Model.EffectiveAmount.ToString("N2")</p>
                        </div>
                    </div>

                    <form asp-controller="Atm" asp-action="ExecuteLoanPayment" method="post">
                        <input type="hidden" asp-for="OriginAccountNumber" />
                        <input type="hidden" asp-for="OriginAccountHolderName" />
                        <input type="hidden" asp-for="LoanNumber" />
                        <input type="hidden" asp-for="LoanHolderName" />
                        <input type="hidden" asp-for="Amount" />
                        <input type="hidden" asp-for="EffectiveAmount" />

                        <div class="d-flex gap-3 justify-content-center">
                            <a asp-controller="Atm" asp-action="Index" class="btn btn-light rounded-2 fw-bold px-5 shadow-sm text-secondary">
                                Cancelar
                            </a>
                            <button type="submit" class="btn btn-success rounded-2 fw-bold px-5 shadow-sm text-white">
                                Confirmar Pago 
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>