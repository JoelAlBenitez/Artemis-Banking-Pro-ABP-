@model ArtemisBankingPro.Core.Application.ViewModels.Atm.LoanPaymentConfirmationViewModel
@{
    ViewData["Title"] = "Confirm Loan Payment";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-warning">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0"><i class="bi bi-exclamation-triangle"></i> Confirm Payment</h4>
                </div>
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    
                    <h5 class="card-title text-center mb-4">Are you sure you want to make this payment?</h5>
                    
                    <ul class="list-group list-group-flush mb-4">
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <strong>Origin Account Holder:</strong>
                            <span>@Model.OriginAccountHolderName</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <strong>Origin Account Number:</strong>
                            <span>@Model.OriginAccountNumber</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center mt-2 border-top pt-3">
                            <strong>Loan Holder:</strong>
                            <span>@Model.LoanHolderName</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <strong>Loan Number:</strong>
                            <span>@Model.LoanNumber</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center mt-2 border-top pt-3">
                            <strong>Entered Amount:</strong>
                            <span>RD$ @Model.Amount.ToString("N2")</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center bg-light">
                            <strong>Effective Amount to Pay:</strong>
                            <span class="text-danger fw-bold">- RD$ @Model.EffectiveAmount.ToString("N2")</span>
                        </li>
                    </ul>

                    <form asp-action="ConfirmLoanPayment" method="post">
                        <input type="hidden" asp-for="OriginAccountNumber" />
                        <input type="hidden" asp-for="LoanNumber" />
                        <input type="hidden" asp-for="Amount" />
                        <input type="hidden" asp-for="EffectiveAmount" />
                        <input type="hidden" asp-for="OriginAccountHolderName" />
                        <input type="hidden" asp-for="LoanHolderName" />
                        
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary px-4">Cancel</a>
                            <button type="submit" class="btn btn-primary px-4">Confirm</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
