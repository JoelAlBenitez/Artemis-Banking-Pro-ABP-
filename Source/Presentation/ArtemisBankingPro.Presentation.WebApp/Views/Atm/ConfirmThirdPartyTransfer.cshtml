@model ArtemisBankingPro.Core.Application.ViewModels.Atm.ThirdPartyTransferConfirmationViewModel
@{
    ViewData["Title"] = "Confirm Transfer";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-warning">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0"><i class="bi bi-exclamation-triangle"></i> Confirm Transfer</h4>
                </div>
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    
                    <h5 class="card-title text-center mb-4">Are you sure you want to make this transfer?</h5>
                    
                    <ul class="list-group list-group-flush mb-4">
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <strong>Origin Account Holder:</strong>
                            <span>@Model.OriginAccountHolderName</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <strong>Origin Account Number:</strong>
                            <span>@Model.OriginAccountNumber</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center mt-2 border-top pt-3">
                            <strong>Destination Account Holder:</strong>
                            <span>@Model.DestinationAccountHolderName</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <strong>Destination Account Number:</strong>
                            <span>@Model.DestinationAccountNumber</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center bg-light mt-2 border-top pt-3">
                            <strong>Amount to Transfer:</strong>
                            <span class="text-danger fw-bold">- RD$ @Model.Amount.ToString("N2")</span>
                        </li>
                    </ul>

                    <form asp-action="ExecuteThirdPartyTransfer" method="post" class="d-flex justify-content-between">
                        <input type="hidden" asp-for="OriginAccountNumber" />
                        <input type="hidden" asp-for="DestinationAccountNumber" />
                        <input type="hidden" asp-for="Amount" />
                        <input type="hidden" asp-for="OriginAccountHolderName" />
                        <input type="hidden" asp-for="DestinationAccountHolderName" />
                        
                        <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2 rounded-pill fw-medium">Cancelar</a>
                        <button type="submit" class="btn btn-primary px-4 py-2 rounded-pill fw-medium shadow-sm">Confirmar</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
