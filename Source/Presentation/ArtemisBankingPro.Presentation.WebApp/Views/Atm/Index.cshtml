@model ArtemisBankingPro.Core.Application.ViewModels.Cajero.DashboardCajeroViewModel
@{
    ViewData["Title"] = "Home Cajero";
    Layout = "_CajeroLayout";
}

<div class="text-center mb-4">
    <h1 class="display-4">Panel del Cajero</h1>
    <p>Resumen operativo del día actual</p>
</div>

<div class="row">
    <div class="col-md-3 mb-4">
        <div class="card text-white bg-primary h-100">
            <div class="card-body">
                <h5 class="card-title">Transacciones realizadas hoy</h5>
                <p class="card-text display-6">@Model.TransaccionesRealizadasHoy</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-4">
        <div class="card text-white bg-success h-100">
            <div class="card-body">
                <h5 class="card-title">Pagos realizados hoy</h5>
                <p class="card-text display-6">@Model.PagosRealizadosHoy</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-4">
        <div class="card text-white bg-info h-100">
            <div class="card-body">
                <h5 class="card-title">Depósitos realizados hoy</h5>
                <p class="card-text display-6">@Model.DepositosRealizadosHoy</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-4">
        <div class="card text-white bg-warning h-100">
            <div class="card-body">
                <h5 class="card-title">Retiros realizados hoy</h5>
                <p class="card-text display-6">@Model.RetirosRealizadosHoy</p>
            </div>
        </div>
    </div>
</div>
