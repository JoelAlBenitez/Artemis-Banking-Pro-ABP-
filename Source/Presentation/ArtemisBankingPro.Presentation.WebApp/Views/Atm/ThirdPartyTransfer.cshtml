@using ArtemisBankingPro.Core.Application.ViewModels.Atm
@model ThirdPartyTransferViewModel
@{
    ViewData["Title"] = "Cajero - Transferencia a Terceros";
}

<div class="container-fluid py-4" style="font-family: 'Montserrat', sans-serif;">
    <div class="row justify-content-center">
        <div class="col-md-9 col-lg-8 col-xl-8">
            
            <div class="mb-4 text-center">
                <div class="mb-2">
                    <i class="bi bi-arrow-left-right fs-3" style="color: #8B5CF6;"></i>
                </div>
                <h2 class="fw-normal mb-1" style="color: #0F172A; font-family: 'Montserrat', sans-serif;">Transferencia A Terceros</h2>
                <p class="text-muted mb-0 fs-6 fw-bold">Transfiere fondos a otras cuentas registradas en el banco.</p>
            </div>

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-5">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger shadow-sm border-0 rounded-3 mb-4">
                            <i class="bi bi-exclamation-circle-fill me-2"></i>
                            <strong>¡Atención!</strong>
                            <div asp-validation-summary="All" class="mt-2 mb-0 small"></div>
                        </div>
                    }

                    <form asp-controller="Atm" asp-action="ThirdPartyTransfer" method="post">
                        
                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <label asp-for="OriginAccountNumber" class="form-label fw-bold text-dark mb-2" style="font-size: 0.95rem;">Cuenta de origen <span class="text-danger">*</span></label>
                                <input asp-for="OriginAccountNumber" type="text" class="form-control rounded-3 py-3 fs-5" placeholder="Ej: 100000000" autocomplete="off" />
                                <span asp-validation-for="OriginAccountNumber" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="DestinationAccountNumber" class="form-label fw-bold text-dark mb-2" style="font-size: 0.95rem;">Cuenta de destino <span class="text-danger">*</span></label>
                                <input asp-for="DestinationAccountNumber" type="text" class="form-control rounded-3 py-3 fs-5" placeholder="Ej: 100000000" autocomplete="off" />
                                <span asp-validation-for="DestinationAccountNumber" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>
                        
                        <div class="mb-4">
                            <p class="text-muted mb-0" style="font-size: 0.85rem;">Verifica los datos antes de continuar.</p>
                        </div>

                        <div class="row g-4 mb-5">
                            <div class="col-md-6">
                                <label asp-for="Amount" class="form-label fw-bold text-dark mb-2" style="font-size: 0.95rem;">Monto de la operación <span class="text-danger">*</span></label>
                                <input asp-for="Amount" type="number" step="0.01" class="form-control rounded-3 py-3 fs-5 fw-bold text-secondary" placeholder="Ej: 1500.00" autocomplete="off" />
                                <span asp-validation-for="Amount" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>

                        <div class="d-flex gap-3 justify-content-end pt-4 mt-4 border-top">
                            <a asp-controller="Atm" asp-action="Index" class="btn btn-outline-secondary rounded-3 px-5 py-2 fw-bold fs-6">Cancelar</a>
                            <button type="submit" class="btn btn-dark rounded-3 px-5 py-2 fw-bold fs-6" style="background-color: #0F172A;">Continuar <i class="bi bi-arrow-left-right ms-2"></i></button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
