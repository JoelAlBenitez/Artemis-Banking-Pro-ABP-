@model ArtemisBankingPro.Core.Application.ViewModels.Atm.ThirdPartyTransferViewModel
@{
    ViewData["Title"] = "Third-Party Transfer";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Third-Party Transfer</h4>
                </div>
                <div class="card-body">
                    <form asp-action="ThirdPartyTransfer" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="form-group mb-3">
                            <label asp-for="OriginAccountNumber" class="control-label">Origin Account Number</label>
                            <input asp-for="OriginAccountNumber" class="form-control" placeholder="Enter origin account number" />
                            <span asp-validation-for="OriginAccountNumber" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="DestinationAccountNumber" class="control-label">Destination Account Number</label>
                            <input asp-for="DestinationAccountNumber" class="form-control" placeholder="Enter destination account number" />
                            <span asp-validation-for="DestinationAccountNumber" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="Amount" class="control-label">Amount to Transfer</label>
                            <input asp-for="Amount" class="form-control" type="number" step="0.01" min="0.01" placeholder="Enter amount" />
                            <span asp-validation-for="Amount" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">Make Transfer</button>
                            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
