@using Artemis_Banking_Pro.Core.Application.ViewModels.SavingsAccounts
@model TransactionListViewModel

@{
    ViewData["Title"] = "Detalles de Cuenta de Ahorro";
}

<div class="container mt-4 mb-5">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold" style="font-family: 'Montserrat', sans-serif; color: #0F172A;">
                <a asp-action="Index" class="text-decoration-none text-muted me-2" title="Volver al Listado">
                    <i class="bi bi-arrow-left-circle"></i>
                </a>
                Detalles de Cuenta
            </h2>
            <p class="text-muted mb-0">Información general y transacciones registradas.</p>
        </div>
    </div>

    <!-- Account Info Cards -->
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 border-start border-4 border-primary">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase fw-bold mb-1" style="font-size: 0.8rem;">Número de Cuenta</h6>
                    <h4 class="mb-0 fw-bold font-monospace text-dark">@Model.SavingsAccount.AccountNumber</h4>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 border-start border-4 border-info">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase fw-bold mb-1" style="font-size: 0.8rem;">Cliente</h6>
                    <h5 class="mb-0 fw-bolder text-dark">@Model.SavingsAccount.FullNameCustomer</h5>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 border-start border-4 border-success">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase fw-bold mb-1" style="font-size: 0.8rem;">Balance Disponible</h6>
                    <h4 class="mb-0 fw-bolder text-success">RD$ @Model.SavingsAccount.Balance.ToString("N2")</h4>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted text-uppercase fw-bold mb-1" style="font-size: 0.8rem;">Tipo de Cuenta</h6>
                        <h5 class="mb-0 fw-bolder text-dark">@Model.SavingsAccount.TypeSavingsAccount</h5>
                    </div>
                    <div>
                        @if (Model.SavingsAccount.TypeSavingsAccount == "Principal")
                        {
                            <span class="badge bg-warning text-dark fs-6"><i class="bi bi-star-fill me-1"></i> Principal</span>
                        }
                        else
                        {
                            <span class="badge bg-light border text-dark fs-6"><i class="bi bi-diagram-2 me-1"></i> Secundaria</span>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted text-uppercase fw-bold mb-1" style="font-size: 0.8rem;">Estado</h6>
                        <h5 class="mb-0 fw-bolder text-dark">@Model.SavingsAccount.StateSavingsAccount</h5>
                    </div>
                    <div>
                        @if (Model.SavingsAccount.StateSavingsAccount == "Cancelada")
                        {
                            <span class="badge bg-secondary fs-6">@Model.SavingsAccount.StateSavingsAccount</span>
                        }
                        else
                        {
                            <span class="badge bg-primary fs-6">@Model.SavingsAccount.StateSavingsAccount</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <h4 class="fw-bold mb-3" style="color: #0F172A;">Historial de Transacciones</h4>
    
    <!-- Transactions Table -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted" style="font-size: 0.85rem;">
                        <tr>
                            <th class="ps-4">FECHA Y HORA</th>
                            <th>TIPO</th>
                            <th>MONTO</th>
                            <th>ORIGEN</th>
                            <th>BENEFICIARIO</th>
                            <th class="text-end pe-4">ESTADO</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Transactions == null || !Model.Transactions.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    No se han registrado transacciones para esta cuenta.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var transaction in Model.Transactions)
                            {
                                <tr>
                                    <td class="ps-4">@transaction.TransactionDate.ToString("dd/MM/yyyy hh:mm tt")</td>
                                    <td>
                                        @if (transaction.TypeTransaction == "CRÉDITO")
                                        {
                                            <span class="text-success fw-bold"><i class="bi bi-arrow-down-circle-fill me-1"></i> @transaction.TypeTransaction</span>
                                        }
                                        else
                                        {
                                            <span class="text-danger fw-bold"><i class="bi bi-arrow-up-circle-fill me-1"></i> @transaction.TypeTransaction</span>
                                        }
                                    </td>
                                    <td class="fw-bold">RD$ @transaction.Amount.ToString("N2")</td>
                                    <td class="text-muted">@transaction.Origin</td>
                                    <td class="text-muted">@transaction.Beneficiary</td>
                                    <td class="text-end pe-4">
                                        @if (transaction.StateTransaction == "APROBADA")
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25"><i class="bi bi-check-circle-fill me-1"></i> @transaction.StateTransaction</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25"><i class="bi bi-x-circle-fill me-1"></i> @transaction.StateTransaction</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4 d-flex justify-content-between align-items-center">
            <span class="text-muted small">Mostrando página @Model.Page de @Model.TotalPages (Total: @Model.TotalRecords transacciones)</span>
            <ul class="pagination pagination-sm mb-0 shadow-sm">
                <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                    <a class="page-link" asp-action="Details" asp-route-id="@Model.SavingsAccount.Id" asp-route-page="@(Model.Page - 1)">
                        Anterior
                    </a>
                </li>
                
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link" asp-action="Details" asp-route-id="@Model.SavingsAccount.Id" asp-route-page="@i">
                            @i
                        </a>
                    </li>
                }

                <li class="page-item @(Model.HasNext ? "" : "disabled")">
                    <a class="page-link" asp-action="Details" asp-route-id="@Model.SavingsAccount.Id" asp-route-page="@(Model.Page + 1)">
                        Siguiente
                    </a>
                </li>
            </ul>
        </nav>
    }
</div>
