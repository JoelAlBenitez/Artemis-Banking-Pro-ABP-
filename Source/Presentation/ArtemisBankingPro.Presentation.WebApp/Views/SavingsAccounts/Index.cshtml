@using Artemis_Banking_Pro.Core.Application.ViewModels.SavingsAccounts
@using ArtemisBankingPro.Core.Domain.Common.Enum
@model SavingsAccountsListViewModel

@{
    ViewData["Title"] = "Gestión de Cuentas de Ahorro";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold" style="font-family: 'Montserrat', sans-serif; color: #0F172A;">
                Gestión de Cuentas de Ahorro
            </h2>
            <p class="text-muted mb-0">Consulta y administra las cuentas principales y secundarias de los clientes.</p>
        </div>
        <div>
            <a asp-action="Assign" class="btn btn-primary fw-bold shadow-sm" style="background-color: #1E293B; border-color: #1E293B;">
                <i class="bi bi-piggy-bank me-2"></i> Asignar Cuenta Secundaria
            </a>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body bg-light">
            <form asp-action="IndexFilter" method="post" class="row gx-3 gy-2 align-items-center">
                <div class="col-sm-4">
                    <label class="fw-bold" style="color: #0F172A;">Buscar por Cédula:</label>
                    <input asp-for="Filter.IdCard" class="form-control shadow-sm" placeholder="Ingrese la cédula del cliente..." />
                </div>
                <div class="col-sm-3">
                    <label class="fw-bold" style="color: #0F172A;">Tipo de Cuenta:</label>
                    <select asp-for="Filter.Type" class="form-select shadow-sm" asp-items="Html.GetEnumSelectList<SavingsAccountTypeFilter>()">
                    </select>
                </div>
                <div class="col-sm-3">
                    <label class="fw-bold" style="color: #0F172A;">Estado de Cuenta:</label>
                    <select asp-for="Filter.Status" class="form-select shadow-sm" asp-items="Html.GetEnumSelectList<SavingsAccountStatusFilter>()">
                    </select>
                </div>
                <div class="col-auto d-flex align-items-end" style="margin-top: 1.8rem;">
                    <button type="submit" class="btn btn-dark fw-bold shadow-sm">
                        <i class="bi bi-search me-1"></i> Buscar
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div asp-validation-summary="ModelOnly" class="alert alert-warning shadow-sm mb-4"></div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted" style="font-size: 0.8rem;">
                        <tr>
                            <th class="ps-4">NÚMERO DE CUENTA</th>
                            <th>CLIENTE</th>
                            <th class="text-center">BALANCE DISPONIBLE</th>
                            <th class="text-center">TIPO</th>
                            <th class="text-center">ESTADO</th>
                            <th class="text-end pe-4">ACCIONES</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.SavingsAccounts == null || !Model.SavingsAccounts.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    No se encontraron cuentas de ahorro con los criterios indicados.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var account in Model.SavingsAccounts)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold font-monospace">@account.AccountNumber</td>
                                    <td>@account.FullNameCustomer</td>
                                    <td class="text-center fw-bold text-success">RD$ @account.Balance.ToString("N2")</td>
                                    <td class="text-center">
                                        @if (account.TypeSavingsAccount.ToString() == "Principal")
                                        {
                                            <div class="d-flex align-items-center justify-content-center">
                                                <span class="status-dot bg-primary me-2"></span>
                                                <span class="text-dark fw-medium" style="font-size: 0.9rem;">@account.TypeSavingsAccount</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="d-flex align-items-center justify-content-center">
                                                <span class="status-dot bg-secondary me-2"></span>
                                                <span class="text-dark fw-medium" style="font-size: 0.9rem;">@account.TypeSavingsAccount</span>
                                            </div>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (account.StateSavingsAccount == "Cancelada")
                                        {
                                            <div class="d-flex align-items-center justify-content-center">
                                                <span class="status-dot bg-secondary me-2"></span>
                                                <span class="text-dark fw-medium" style="font-size: 0.9rem;">@account.StateSavingsAccount</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="d-flex align-items-center justify-content-center">
                                                <span class="status-dot bg-success me-2"></span>
                                                <span class="text-dark fw-medium" style="font-size: 0.9rem;">@account.StateSavingsAccount</span>
                                            </div>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <a asp-action="Details" asp-route-id="@account.Id" class="btn btn-light btn-action text-info shadow-sm border me-1" title="Ver transacciones">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        @if (account.CanBeCancelled)
                                        {
                                            <a asp-action="Cancel" asp-route-id="@account.Id" class="btn btn-light btn-action text-danger shadow-sm border" title="Cancelar">
                                                <i class="bi bi-x-circle"></i>
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4 d-flex justify-content-between align-items-center">
            <span class="text-muted small">Mostrando página @Model.Page de @Model.TotalPages (Total: @Model.TotalRecords cuentas)</span>
            <ul class="pagination pagination-sm mb-0 shadow-sm">
                <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-filter.Page="@(Model.Page - 1)" asp-route-filter.IdCard="@Model.Filter.IdCard" asp-route-filter.Status="@Model.Filter.Status" asp-route-filter.Type="@Model.Filter.Type">
                        Anterior
                    </a>
                </li>
                
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-filter.Page="@i" asp-route-filter.IdCard="@Model.Filter.IdCard" asp-route-filter.Status="@Model.Filter.Status" asp-route-filter.Type="@Model.Filter.Type">
                            @i
                        </a>
                    </li>
                }

                <li class="page-item @(Model.HasNext ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-filter.Page="@(Model.Page + 1)" asp-route-filter.IdCard="@Model.Filter.IdCard" asp-route-filter.Status="@Model.Filter.Status" asp-route-filter.Type="@Model.Filter.Type">
                        Siguiente
                    </a>
                </li>
            </ul>
        </nav>
    }
</div>
