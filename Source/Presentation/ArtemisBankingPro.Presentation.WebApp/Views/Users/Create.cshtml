@using Artemis_Banking_Pro.Core.Application.ViewModels.Users
@model SaveUserViewModel

@{
    ViewData["Title"] = "Crear Usuario";
}

<div class="container mt-5 mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="fw-bold mb-1" style="font-family: 'Montserrat', sans-serif; color: #0F172A;">
                <a asp-action="Index" class="text-decoration-none text-muted me-2" title="Volver">
                    <i class="bi bi-arrow-left-circle"></i>
                </a>
                Crear Usuario
            </h4>
            <p class="text-muted mb-0 small">Complete la información para registrar un nuevo usuario en el sistema.</p>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-3">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm mb-3 py-2"></div>

                <div class="row g-2 mb-2">
                    <div class="col-md-6">
                        <label asp-for="FirstName" class="form-label fw-bold small mb-1" style="color: #0F172A;">Nombres</label>
                        <input asp-for="FirstName" class="form-control form-control-sm bg-light shadow-sm" placeholder="Ej. Juan Carlos" />
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="LastName" class="form-label fw-bold small mb-1" style="color: #0F172A;">Apellidos</label>
                        <input asp-for="LastName" class="form-control form-control-sm bg-light shadow-sm" placeholder="Ej. Pérez" />
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="IDCARD" class="form-label fw-bold small mb-1" style="color: #0F172A;">Cédula</label>
                        <input asp-for="IDCARD" class="form-control form-control-sm bg-light shadow-sm" placeholder="11 dígitos sin guiones" />
                        <span asp-validation-for="IDCARD" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label fw-bold small mb-1" style="color: #0F172A;">Correo Electrónico</label>
                        <input asp-for="Email" type="email" class="form-control form-control-sm bg-light shadow-sm" placeholder="correo@ejemplo.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="UserName" class="form-label fw-bold small mb-1" style="color: #0F172A;">Nombre de Usuario</label>
                        <input asp-for="UserName" class="form-control form-control-sm bg-light shadow-sm" placeholder="usuario123" />
                        <span asp-validation-for="UserName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Password" class="form-label fw-bold small mb-1" style="color: #0F172A;">Contraseña</label>
                        <input asp-for="Password" type="password" class="form-control form-control-sm bg-light shadow-sm" placeholder="••••••••" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-bold small mb-1" style="color: #0F172A;">Confirmar Contraseña</label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control form-control-sm bg-light shadow-sm" placeholder="••••••••" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="col-12"><hr class="text-muted opacity-25 my-1" /></div>

                    <div class="col-md-6">
                        <label asp-for="Role" class="form-label fw-bold small mb-1" style="color: #0F172A;">Tipo de Usuario</label>
                        <select asp-for="Role" class="form-select form-select-sm bg-light shadow-sm" id="RoleSelect">
                            <option value="">Seleccione un rol...</option>
                            @foreach (var role in Model.AvailableRoles)
                            {
                                <option value="@role">@role</option>
                            }
                        </select>
                        <span asp-validation-for="Role" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6" id="InitialAmountContainer" style="display: none;">
                        <label asp-for="InitialAmount" class="form-label fw-bold small mb-1" style="color: #0F172A;">Monto Inicial (RD$)</label>
                        <div class="input-group shadow-sm">
                            <span class="input-group-text bg-light text-muted">RD$</span>
                            <input asp-for="InitialAmount" type="number" step="0.01" min="0" class="form-control form-control-sm bg-light" placeholder="0.00" />
                        </div>
                        <span asp-validation-for="InitialAmount" class="text-danger small"></span>
                        <div class="form-text text-muted small mt-1">Este monto será asignado a la nueva cuenta de ahorro principal.</div>
                    </div>
                </div>

                <div class="d-flex justify-content-end mt-3">
                    <a asp-action="Index" class="btn btn-sm btn-light fw-bold shadow-sm me-2 px-3">Cancelar</a>
                    <button type="submit" class="btn btn-sm btn-primary fw-bold shadow-sm px-4" style="background-color: #1E293B; border-color: #1E293B;">
                        <i class="bi bi-save me-2"></i> Guardar Usuario
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var roleSelect = document.getElementById('RoleSelect');
            var initialAmountContainer = document.getElementById('InitialAmountContainer');
            
            function toggleInitialAmount() {
                if (roleSelect.value === 'Cliente') {
                    // Animación suave usando Bootstrap collapse/display (aquí usamos display básico para simular)
                    initialAmountContainer.style.display = 'block';
                    // Pequeña animación de opacidad
                    initialAmountContainer.style.opacity = 0;
                    setTimeout(function() {
                        initialAmountContainer.style.transition = 'opacity 0.3s ease-in';
                        initialAmountContainer.style.opacity = 1;
                    }, 10);
                } else {
                    initialAmountContainer.style.display = 'none';
                    // Limpiar el valor si se oculta para evitar envíos no deseados
                    var inputAmount = document.querySelector('input[name="InitialAmount"]');
                    if (inputAmount) {
                        inputAmount.value = '';
                    }
                }
            }

            roleSelect.addEventListener('change', toggleInitialAmount);
            // Ejecutar al cargar la página en caso de un post-back fallido que mantenga el valor
            toggleInitialAmount();
        });
    </script>
}
