@using Artemis_Banking_Pro.Core.Application.ViewModels.Users
@model UsersListViewModel

@{
    ViewData["Title"] = "Gestión de Usuarios";
}

<div class="container mt-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold" style="font-family: 'Montserrat', sans-serif; color: #0F172A;">
                Gestión de Usuarios
            </h2>
            <p class="text-muted mb-0">Consulta, crea y administra los usuarios del sistema.</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary fw-bold shadow-sm" style="background-color: #4472C4; border-color: #4472C4;">
                <i class="bi bi-person-plus me-2"></i> Crear usuario
            </a>
        </div>
    </div>

    <!-- Filters and Alerts -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body bg-light">
            <form asp-action="IndexFilter" method="post" class="row gx-3 gy-2 align-items-center">
                <div class="col-auto">
                    <label class="fw-bold" style="color: #0F172A;">Filtrar por Tipo de Usuario:</label>
                </div>
                <div class="col-sm-4">
                    <select asp-for="Filter.Role" class="form-select shadow-sm"
                            asp-items="@(new SelectList(Model.AvailableRoles))">
                        <option value="">Todos</option>
                    </select>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-dark fw-bold shadow-sm">
                        Aplicar Filtro
                    </button>
                </div>
            </form>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Users Table -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted" style="font-size: 0.85rem;">
                        <tr>
                            <th class="ps-4">NOMBRE DE USUARIO</th>
                            <th>CÉDULA</th>
                            <th>NOMBRE COMPLETO</th>
                            <th>CORREO ELECTRÓNICO</th>
                            <th>TIPO DE USUARIO</th>
                            <th>ESTADO</th>
                            <th class="text-end pe-4">ACCIONES</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Users == null || !Model.Users.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    No se encontraron usuarios registrados.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var user in Model.Users)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold">@user.UserName</td>
                                    <td>@user.IDCARD</td>
                                    <td>@user.FullName</td>
                                    <td>@user.Email</td>
                                    <td>
                                        <span class="badge bg-secondary">@user.TypeUser</span>
                                    </td>
                                    <td>
                                        @if (user.IsActive)
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">@user.State</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25">@user.State</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary fw-bold me-2">
                                            Editar
                                        </a>
                                        
                                        @if (user.IsActive)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger fw-bold" onclick="showToggleModal('@user.Id', 'inactivar')">
                                                Inactivar
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-success fw-bold" onclick="showToggleModal('@user.Id', 'activar')">
                                                Activar
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4 d-flex justify-content-between align-items-center">
            <span class="text-muted small">Mostrando página @Model.Page de @Model.TotalPages (Total: @Model.TotalRecords usuarios)</span>
            <ul class="pagination pagination-sm mb-0 shadow-sm">
                <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-filter.Page="@(Model.Page - 1)" asp-route-filter.Role="@Model.Filter.Role">
                        Anterior
                    </a>
                </li>
                
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-filter.Page="@i" asp-route-filter.Role="@Model.Filter.Role">
                            @i
                        </a>
                    </li>
                }

                <li class="page-item @(Model.HasNext ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-filter.Page="@(Model.Page + 1)" asp-route-filter.Role="@Model.Filter.Role">
                        Siguiente
                    </a>
                </li>
            </ul>
        </nav>
    }
</div>

<!-- Modal de Confirmación para Activar/Inactivar -->
<div class="modal fade" id="toggleUserModal" tabindex="-1" aria-labelledby="toggleUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-bottom-0">
                <h5 class="modal-title fw-bold" id="toggleUserModalLabel" style="color: #0F172A;">Confirmar Acción</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p id="toggleUserMessage" class="mb-0">¿Está seguro que desea aplicar este cambio?</p>
            </div>
            <div class="modal-footer border-top-0">
                <form id="toggleUserForm" asp-action="ToggleStatus" method="post">
                    <input type="hidden" id="toggleUserId" name="id" value="" />
                    <button type="button" class="btn btn-light fw-bold shadow-sm" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-dark fw-bold shadow-sm">Aceptar</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showToggleModal(userId, action) {
            document.getElementById('toggleUserId').value = userId;
            
            var message = action === 'inactivar' 
                ? '¿Está seguro que desea inactivar este usuario?' 
                : '¿Está seguro que desea activar este usuario?';
                
            document.getElementById('toggleUserMessage').textContent = message;
            
            var modal = new bootstrap.Modal(document.getElementById('toggleUserModal'));
            modal.show();
        }
    </script>
}
