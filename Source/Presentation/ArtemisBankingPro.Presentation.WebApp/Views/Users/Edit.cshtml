@using Artemis_Banking_Pro.Core.Application.ViewModels.Users
@model EditUserViewModel

@{
    ViewData["Title"] = "Editar Usuario";
}

<div class="container mt-4 mb-5">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold" style="font-family: 'Montserrat', sans-serif; color: #0F172A;">
                <a asp-action="Index" class="text-decoration-none text-muted me-2" title="Volver">
                    <i class="bi bi-arrow-left-circle"></i>
                </a>
                Editar Usuario
            </h2>
            <p class="text-muted mb-0">Modifique la información del usuario existente.</p>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4 p-md-5">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="IsClient" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm mb-4"></div>

                <div class="row g-4 mb-4">
                    <!-- Nombres y Apellidos -->
                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label fw-bold" style="color: #0F172A;">Nombres</label>
                        <input asp-for="Name" class="form-control form-control-lg bg-light shadow-sm" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="LastName" class="form-label fw-bold" style="color: #0F172A;">Apellidos</label>
                        <input asp-for="LastName" class="form-control form-control-lg bg-light shadow-sm" />
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>

                    <!-- Cédula y Correo -->
                    <div class="col-md-6">
                        <label asp-for="IDCARD" class="form-label fw-bold" style="color: #0F172A;">Cédula</label>
                        <input asp-for="IDCARD" class="form-control form-control-lg bg-light shadow-sm" />
                        <span asp-validation-for="IDCARD" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label fw-bold" style="color: #0F172A;">Correo Electrónico</label>
                        <input asp-for="Email" type="email" class="form-control form-control-lg bg-light shadow-sm" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <!-- Usuario -->
                    <div class="col-md-12">
                        <label asp-for="UserName" class="form-label fw-bold" style="color: #0F172A;">Nombre de Usuario</label>
                        <input asp-for="UserName" class="form-control form-control-lg bg-light shadow-sm" />
                        <span asp-validation-for="UserName" class="text-danger small"></span>
                    </div>

                    <div class="col-12"><hr class="text-muted opacity-25" /></div>
                    <div class="col-12">
                        <h6 class="fw-bold" style="color: #0F172A;">Seguridad</h6>
                        <p class="small text-muted">Deje los campos de contraseña en blanco si no desea modificarla.</p>
                    </div>

                    <!-- Nueva Contraseña -->
                    <div class="col-md-6">
                        <label asp-for="NewPassword" class="form-label fw-bold" style="color: #0F172A;">Nueva Contraseña</label>
                        <input asp-for="NewPassword" type="password" class="form-control form-control-lg bg-light shadow-sm" placeholder="••••••••" />
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ConfirmNewPassword" class="form-label fw-bold" style="color: #0F172A;">Confirmar Nueva Contraseña</label>
                        <input asp-for="ConfirmNewPassword" type="password" class="form-control form-control-lg bg-light shadow-sm" placeholder="••••••••" />
                        <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                    </div>

                    @if (Model.IsClient)
                    {
                        <div class="col-12"><hr class="text-muted opacity-25" /></div>
                        
                        <!-- Monto Adicional para Cliente -->
                        <div class="col-md-6">
                            <label asp-for="AdditionalAmount" class="form-label fw-bold" style="color: #0F172A;">
                                Monto Adicional a Acreditar (RD$)
                            </label>
                            <div class="input-group shadow-sm">
                                <span class="input-group-text bg-success text-white">RD$</span>
                                <input asp-for="AdditionalAmount" type="number" step="0.01" min="0" class="form-control form-control-lg bg-light" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="AdditionalAmount" class="text-danger small"></span>
                            <div class="form-text text-muted small mt-1">
                                Este monto se sumará al balance actual de la cuenta de ahorro principal. Déjelo vacío o en 0 si no desea realizar ninguna acreditación.
                            </div>
                        </div>
                    }
                </div>

                <div class="d-flex justify-content-end mt-5">
                    <a asp-action="Index" class="btn btn-light fw-bold shadow-sm me-3 px-4 py-2">Cancelar</a>
                    <button type="submit" class="btn btn-primary fw-bold shadow-sm px-5 py-2" style="background-color: #4472C4; border-color: #4472C4;">
                        <i class="bi bi-save me-2"></i> Guardar Cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
