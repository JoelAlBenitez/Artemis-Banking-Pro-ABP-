@using Artemis_Banking_Pro.Core.Application.ViewModels.Loans
@model EditAnnualInterestRateViewModel

@{
    ViewData["Title"] = "Editar Tasa de Interés";
}

<div class="container mt-4 mb-5 d-flex justify-content-center">
    <div class="card shadow-sm border-0" style="max-width: 500px; width: 100%;">
        <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
            <h2 class="fw-bold" style="font-family: 'Montserrat', sans-serif; color: #0F172A;">
                <a asp-action="Index" class="text-decoration-none text-muted me-2" title="Volver al Listado">
                    <i class="bi bi-arrow-left-circle"></i>
                </a>
                Editar Tasa
            </h2>
            <p class="text-muted small mb-0">Modifique la tasa de interés anual. Solo afectará las cuotas futuras pendientes.</p>
        </div>

        <div class="card-body p-4">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="LoansId" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm mb-4"></div>

                <div class="mb-4">
                    <label asp-for="AnnualInterestRate" class="form-label fw-bold" style="color: #0F172A;">Nueva Tasa de Interés Anual (%)</label>
                    <div class="input-group shadow-sm">
                        <input asp-for="AnnualInterestRate" type="number" step="0.01" min="0" class="form-control form-control-lg bg-light text-center fw-bold fs-4" placeholder="0.00" />
                        <span class="input-group-text bg-primary text-white"><i class="bi bi-percent"></i></span>
                    </div>
                    <span asp-validation-for="AnnualInterestRate" class="text-danger small"></span>
                </div>

                <div class="alert alert-info border-0 shadow-sm small">
                    <i class="bi bi-info-circle-fill me-2"></i> Esta acción recalculará automáticamente la tabla de amortización para las cuotas no pagadas.
                </div>

                <div class="d-flex justify-content-end mt-4">
                    <a asp-action="Index" class="btn btn-light fw-bold shadow-sm me-2 px-4">Volver atrás</a>
                    <button type="submit" class="btn btn-primary fw-bold shadow-sm px-4" style="background-color: #0F172A; border-color: #0F172A;">
                        Modificar tasa <i class="bi bi-arrow-repeat ms-1"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
