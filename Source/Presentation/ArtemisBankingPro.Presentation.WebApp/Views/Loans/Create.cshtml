@using Artemis_Banking_Pro.Core.Application.ViewModels.Loans
@using ArtemisBankingPro.Core.Domain.Common.Enum
@model LoansAssigmentViewModel

@{
    ViewData["Title"] = "Configurar Préstamo";
}

<div class="container mt-4 mb-5">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold" style="font-family: 'Montserrat', sans-serif; color: #0F172A;">
                <a asp-action="Assign" class="text-decoration-none text-muted me-2" title="Volver a Selección">
                    <i class="bi bi-arrow-left-circle"></i>
                </a>
                Paso 2: Configurar Préstamo
            </h2>
            <p class="text-muted mb-0">Establezca las condiciones del préstamo para el cliente seleccionado.</p>
        </div>
    </div>

    <!-- Cliente Info -->
    <div class="alert shadow-sm border-0 d-flex align-items-center" style="background-color: #F8FAFC; color: #0F172A;">
        <i class="bi bi-person-check-fill fs-3 me-3" style="color: #0F172A;"></i>
        <div>
            <h6 class="mb-0 text-muted small text-uppercase fw-bold">Cliente Seleccionado</h6>
            <p class="mb-0 fs-5 fw-bold">@Model.FullNameCustomer</p>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4 p-md-5">
            <form asp-action="Create" method="post">
                <input type="hidden" asp-for="CustomerId" />
                <input type="hidden" asp-for="FullNameCustomer" />
                <input type="hidden" asp-for="ConfirmHighRisk" value="false" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm mb-4"></div>

                <div class="row g-4 mb-4">
                    <!-- Monto a Prestar -->
                    <div class="col-md-4">
                        <label asp-for="AmmountLoans" class="form-label fw-bold" style="color: #0F172A;">Monto a Prestar (RD$)</label>
                        <div class="input-group shadow-sm">
                            <span class="input-group-text bg-success text-white">RD$</span>
                            <input asp-for="AmmountLoans" type="number" step="0.01" min="0.01" class="form-control form-control-lg bg-light" placeholder="0.00" />
                        </div>
                        <span asp-validation-for="AmmountLoans" class="text-danger small"></span>
                    </div>

                    <!-- Tasa de Interés -->
                    <div class="col-md-4">
                        <label asp-for="AnnualInterestRate" class="form-label fw-bold" style="color: #0F172A;">Tasa de Interés Anual (%)</label>
                        <div class="input-group shadow-sm">
                            <input asp-for="AnnualInterestRate" type="number" step="0.01" min="0" class="form-control form-control-lg bg-light" placeholder="0.00" />
                            <span class="input-group-text bg-light">%</span>
                        </div>
                        <span asp-validation-for="AnnualInterestRate" class="text-danger small"></span>
                    </div>

                    <!-- Plazo -->
                    <div class="col-md-4">
                        <label asp-for="TermLoans" class="form-label fw-bold" style="color: #0F172A;">Plazo del Préstamo</label>
                        <select asp-for="TermLoans" class="form-select form-select-lg bg-light shadow-sm">
                            <option value="">Seleccione el plazo...</option>
                            <option value="6">6 Meses</option>
                            <option value="12">12 Meses</option>
                            <option value="18">18 Meses</option>
                            <option value="24">24 Meses</option>
                            <option value="30">30 Meses</option>
                            <option value="36">36 Meses</option>
                            <option value="42">42 Meses</option>
                            <option value="48">48 Meses</option>
                            <option value="54">54 Meses</option>
                            <option value="60">60 Meses</option>
                        </select>
                        <span asp-validation-for="TermLoans" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end mt-5">
                    <a asp-action="Assign" class="btn btn-light fw-bold shadow-sm me-3 px-4 py-2">Volver atrás</a>
                    <button type="submit" class="btn btn-primary fw-bold shadow-sm px-5 py-2" style="background-color: #1E293B; border-color: #1E293B;">
                        Asignar préstamo <i class="bi bi-check-circle ms-1"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
