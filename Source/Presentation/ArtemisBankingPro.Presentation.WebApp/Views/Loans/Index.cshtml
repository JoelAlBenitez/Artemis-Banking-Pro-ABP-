    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted" style="font-size: 0.8rem;">
                        <tr>
                            <th class="ps-4">NÚMERO</th>
                            <th>CLIENTE</th>
                            <th class="text-center">CAPITAL</th>
                            <th class="text-center">CUOTAS (PAG/TOT)</th>
                            <th class="text-center">PENDIENTE</th>
                            <th class="text-center">TASA</th>
                            <th class="text-center">PLAZO</th>
                            <th class="text-center">ESTADO PRÉSTAMO</th>
                            <th class="text-center">ESTADO CLIENTE</th>
                            <th class="text-end pe-4">ACCIONES</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Loans == null || !Model.Loans.Any())
                        {
                            <tr>
                                <td colspan="10" class="text-center py-5 text-muted">
                                    No se encontraron préstamos con los criterios indicados.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var loan in Model.Loans)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold">@loan.LoanNumber</td>
                                    <td>@loan.FullNameCustomer</td>
                                    <td class="text-center fw-bold text-success">RD$ @loan.AprovechedCapital.ToString("N2")</td>
                                    <td class="text-center">
                                        <span class="badge bg-secondary">@loan.InstallmentPay / @loan.QuantityInstallment</span>
                                    </td>
                                    <td class="text-center fw-bold text-danger">RD$ @loan.PendientAmount.ToString("N2")</td>
                                    <td class="text-center">@loan.AnnualInterestRate.ToString("N2")%</td>
                                    <td class="text-center">@loan.Term Meses</td>
                                    <td class="text-center">
                                        @if (loan.StateLoans == "Completado")
                                        {
                                            <span class="text-dark fw-bold"><i class="bi bi-circle-fill text-secondary me-1" style="font-size: 0.5rem; vertical-align: middle;"></i> @loan.StateLoans</span>
                                        }
                                        else
                                        {
                                            <span class="text-dark fw-bold"><i class="bi bi-circle-fill text-success me-1" style="font-size: 0.5rem; vertical-align: middle;"></i> @loan.StateLoans</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (loan.StateCustomer == "Al día")
                                        {
                                            <span class="text-dark fw-bold"><i class="bi bi-circle-fill text-success me-1" style="font-size: 0.5rem; vertical-align: middle;"></i> @loan.StateCustomer</span>
                                        }
                                        else
                                        {
                                            <span class="text-dark fw-bold"><i class="bi bi-circle-fill text-danger me-1" style="font-size: 0.5rem; vertical-align: middle;"></i> @loan.StateCustomer</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <a asp-action="Details" asp-route-id="@loan.Id" class="btn btn-sm btn-outline-info me-2" title="Ver detalles y tabla de amortización">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@loan.Id" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4 d-flex justify-content-between align-items-center">
            <span class="text-muted small">Mostrando página @Model.Page de @Model.TotalPages (Total: @Model.TotalRecords préstamos)</span>
            <ul class="pagination pagination-sm mb-0 shadow-sm">
                <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-filter.Page="@(Model.Page - 1)" asp-route-filter.IdCard="@Model.Filter.IdCard" asp-route-filter.Status="@Model.Filter.Status">
                        Anterior
                    </a>
                </li>
                
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-filter.Page="@i" asp-route-filter.IdCard="@Model.Filter.IdCard" asp-route-filter.Status="@Model.Filter.Status">
                            @i
                        </a>
                    </li>
                }

                <li class="page-item @(Model.HasNext ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-filter.Page="@(Model.Page + 1)" asp-route-filter.IdCard="@Model.Filter.IdCard" asp-route-filter.Status="@Model.Filter.Status">
                        Siguiente
                    </a>
                </li>
            </ul>
        </nav>
    }
</div>
