@using Artemis_Banking_Pro.Core.Application.ViewModels.Loans
@using ArtemisBankingPro.Core.Domain.Common.Enum
@model LoansListViewModel

@{
    ViewData["Title"] = "Gestión de Préstamos";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold" style="font-family: 'Montserrat', sans-serif; color: #0F172A;">
                Gestión de Préstamos
            </h2>
            <p class="text-muted mb-0">Consulta y administra los préstamos activos y completados del sistema.</p>
        </div>
        <div>
            <a asp-action="Assign" class="btn btn-primary fw-bold shadow-sm" style="background-color: #1E293B; border-color: #1E293B;">
                <i class="bi bi-cash-stack me-2"></i> Asignar Préstamo
            </a>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body bg-light">
            <form asp-action="Index" method="post" class="row gx-3 gy-2 align-items-center">
                <div class="col-sm-4">
                    <label class="fw-bold" style="color: #0F172A;">Buscar por Cédula:</label>
                    <input asp-for="Filter.IdCard" class="form-control shadow-sm" placeholder="Ingrese la cédula del cliente..." />
                </div>
                <div class="col-sm-4">
                    <label class="fw-bold" style="color: #0F172A;">Estado del Préstamo:</label>
                    <select asp-for="Filter.Status" class="form-select shadow-sm" asp-items="Html.GetEnumSelectList<LoanStatusFilter>()">
                    </select>
                </div>
                <div class="col-auto d-flex align-items-end" style="margin-top: 1.8rem;">
                    <button type="submit" class="btn btn-dark fw-bold shadow-sm">
                        <i class="bi bi-search me-1"></i> Buscar
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div asp-validation-summary="ModelOnly" class="alert alert-warning shadow-sm mb-4"></div>

