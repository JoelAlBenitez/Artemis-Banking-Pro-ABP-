@using Artemis_Banking_Pro.Core.Application.ViewModels.Loans
@model DetailsLoansViewModel

@{
    ViewData["Title"] = "Detalles del Préstamo";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold" style="font-family: 'Montserrat', sans-serif; color: #0F172A;">
                <a asp-action="Index" class="text-decoration-none text-muted me-2" title="Volver al Listado">
                    <i class="bi bi-arrow-left-circle"></i>
                </a>
                Detalles del Préstamo
            </h2>
            <p class="text-muted mb-0">Información general y tabla de amortización.</p>
        </div>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase fw-bold mb-1" style="font-size: 0.8rem;">Número de Préstamo</h6>
                    <h4 class="mb-0 fw-bolder text-dark">@Model.NumberLoand</h4>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase fw-bold mb-1" style="font-size: 0.8rem;">Cliente</h6>
                    <h5 class="mb-0 fw-bolder text-dark">@Model.FullNameCustomer</h5>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase fw-bold mb-1" style="font-size: 0.8rem;">Monto Aprobado</h6>
                    <h4 class="mb-0 fw-bolder text-success">RD$ @Model.ApprovedAmount.ToString("N2")</h4>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase fw-bold mb-1" style="font-size: 0.8rem;">Tasa de Interés Anual</h6>
                    <h5 class="mb-0 fw-bolder text-dark">@Model.AnnualInterestRate.ToString("N2")%</h5>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase fw-bold mb-1" style="font-size: 0.8rem;">Plazo</h6>
                    <h5 class="mb-0 fw-bolder text-dark">@Model.Term Meses</h5>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase fw-bold mb-1" style="font-size: 0.8rem;">Estado del Préstamo</h6>
                    <h5 class="mb-0 fw-bolder text-dark">
                        @if (Model.StateLoans == "Completado")
                        {
                            <span class="badge bg-success">@Model.StateLoans</span>
                        }
                        else
                        {
                            <span class="badge bg-primary">@Model.StateLoans</span>
                        }
                    </h5>
                </div>
            </div>
        </div>
    </div>

    <h4 class="fw-bold mb-3" style="color: #0F172A;">Tabla de Amortización</h4>
    
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive" style="max-height: 600px; overflow-y: auto;">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted sticky-top" style="font-size: 0.85rem;">
                        <tr>
                            <th class="ps-4">CUOTA</th>
                            <th>FECHA DE VENCIMIENTO</th>
                            <th>VALOR DE CUOTA</th>
                            <th>SALDO PENDIENTE</th>
                            <th>ESTADO</th>
                            <th class="text-end pe-4">ATRASO</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.loasInstallmentViewModels == null || !Model.loasInstallmentViewModels.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    No hay cuotas generadas para este préstamo.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var cuota in Model.loasInstallmentViewModels.OrderBy(c => c.NumberLoanInstallment))
                            {
                                <tr>
                                    <td class="ps-4 fw-bold">#@cuota.NumberLoanInstallment</td>
                                    <td>@cuota.DueDate.ToString("dd/MM/yyyy")</td>
                                    <td class="fw-bold">RD$ @cuota.InstallmentValue.ToString("N2")</td>
                                    <td class="text-danger fw-bold">RD$ @cuota.OutstandingBalance.ToString("N2")</td>
                                    <td>
                                        @if (cuota.StateInstallment == "Pagada")
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">@cuota.StateInstallment</span>
                                        }
                                        else if (cuota.StateInstallment == "Pendiente")
                                        {
                                            <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25">@cuota.StateInstallment</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25">@cuota.StateInstallment</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        @if (cuota.IsOverdue)
                                        {
                                            <span class="badge bg-danger"><i class="bi bi-exclamation-triangle me-1"></i> Atrasada</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">-</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
