@using ArtemisBankingPro.Core.Application.DTOs.Account
@model ResetPasswordRequest
@{
    Layout = null;
    ViewData["Title"] = "Restablecer Contraseña - Artemis";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Montserrat:wght@700;800;900&display=swap" rel="stylesheet">
    <style>
        :root {
            --brand-primary: #1E293B; 
            --brand-secondary: #5684D8;
            --brand-accent: #8FAFF0;
            --text-dark: #1F2937;
            --text-light: #F9FAFB;
            --bg-color: #FFFFFF;
            --input-bg: #F4F6F8;
            --border-radius: 8px; 
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-color);
            margin: 0;
            height: 100vh;
            overflow: hidden; 
        }

        .split-layout {
            display: flex;
            height: 100vh;
        }

        .brand-panel {
            flex: 0 0 30%;
            background: linear-gradient(135deg, rgba(15, 23, 42, 0.70) 0%, rgba(15, 23, 42, 0.85) 100%), 
                        url('https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?q=80&w=2070&auto=format&fit=crop');
            background-size: cover;
            background-position: center;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            color: var(--text-light);
            position: relative;
        }

        .login-panel {
            flex: 1;
            display: flex;
            justify-content: flex-start;
            padding-left: 7vw;
            align-items: center;
            background-color: var(--bg-color);
        }

        .login-card {
            width: 100%;
            max-width: 420px;
            padding: 2.5rem;
            animation: fadeIn 0.8s ease-out;
        }

        .login-header {
            margin-bottom: 2.5rem;
            text-align: left;
        }

        .brand-logo-container {
            display: flex;
            align-items: center;
            gap: 0.4rem;
            margin-bottom: 0.5rem;
        }

        .brand-logo-text {
            font-family: 'Montserrat', sans-serif;
            font-size: 3.2rem;
            font-weight: 900;
            color: #0F172A; 
            letter-spacing: 2px;
            text-transform: uppercase;
            margin: 0;
            line-height: 1;
        }

        .login-header p {
            color: #6B7280;
            font-size: 1.05rem;
            font-weight: 400;
        }

        .input-group {
            background-color: var(--input-bg);
            border-radius: var(--border-radius);
            border: 1px solid transparent;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
        }

        .input-group-text {
            background-color: transparent;
            border: none;
            color: #6B7280;
            padding-left: 1.2rem;
            font-size: 1.1rem;
        }

        .form-control {
            background-color: transparent;
            border: none;
            height: 3.6rem;
            font-size: 0.95rem;
            color: var(--text-dark);
            box-shadow: none !important;
            padding-left: 0.8rem;
        }

        .form-control:focus,
        .form-control:active,
        .form-control:focus-visible {
            outline: none !important;
            box-shadow: none !important;
            border: none !important;
            background-color: transparent !important;
        }

        .input-group:focus-within {
            background-color: #FFFFFF;
            border-color: var(--brand-accent);
            box-shadow: 0 0 0 4px rgba(87, 108, 188, 0.1);
        }

        .input-group:focus-within .input-group-text i {
            color: var(--brand-primary);
        }

        .form-label {
            font-size: 0.85rem;
            font-weight: 600;
            color: #4B5563;
            margin-bottom: 0.5rem;
        }

        .btn-premium {
            background-color: var(--brand-primary);
            color: white;
            border: none;
            border-radius: var(--border-radius);
            padding: 0.9rem;
            font-size: 1rem;
            font-weight: 600;
            letter-spacing: 0.5px;
            width: 100%;
            margin-top: 1.5rem;
            transition: all 0.3s ease;
        }

        .btn-premium:hover {
            background-color: var(--brand-secondary);
            transform: translateY(-2px);
            box-shadow: 0 8px 15px rgba(11, 36, 71, 0.2);
            color: white;
        }

        .forgot-link {
            display: inline-block;
            margin-top: 1.5rem;
            color: #6B7280;
            text-decoration: none;
            font-size: 0.95rem;
            font-weight: 500;
            transition: color 0.2s ease;
        }

        .forgot-link:hover {
            color: var(--brand-accent);
        }

        .validation-alert {
            background-color: #FFFBEB;
            color: #92400E;
            padding: 0.8rem 1rem;
            margin-bottom: 1.5rem;
            border-radius: 4px;
            font-size: 0.95rem;
            display: flex;
            align-items: center;
        }
        
        .success-alert {
            background-color: #ECFDF5;
            color: #065F46;
            padding: 0.8rem 1rem;
            margin-bottom: 1.5rem;
            border-radius: 4px;
            font-size: 0.95rem;
            display: flex;
            align-items: center;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @@media (max-width: 768px) {
            .split-layout {
                flex-direction: column;
            }
            .brand-panel {
                flex: 0 0 20%;
            }
            .login-panel {
                padding-left: 0;
                justify-content: center;
                padding: 2rem;
            }
            .login-card {
                padding: 1.5rem;
                max-width: 100%;
            }
        }
    </style>
</head>
<body>
    <div class="split-layout">
        <!-- Panel Izquierdo: Branding -->
        <div class="brand-panel">
            <!-- Optional branding text can go here -->
        </div>

        <!-- Panel Derecho: Formulario -->
        <div class="login-panel">
            <div class="login-card">
                <div class="login-header">
                    <div class="brand-logo-container">
                        <h1 class="brand-logo-text">ARTEMIS<span style="color: var(--brand-secondary);">.</span></h1>
                    </div>
                    <p>Crea una nueva contraseña</p>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="validation-alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <div asp-validation-summary="All" class="mb-0"></div>
                    </div>
                }

                @if (ViewBag.Message != null)
                {
                    <div class="success-alert">
                        <i class="bi bi-check-circle-fill me-2"></i>
                        @ViewBag.Message
                    </div>
                }
                else
                {
                    <form asp-action="ResetPassword" method="post">
                        <input type="hidden" asp-for="Token" />
                        <input type="hidden" asp-for="Email" />

                        <div class="mb-4">
                            <label asp-for="Password" class="form-label">Nueva Contraseña</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-lock"></i></span>
                                <input asp-for="Password" class="form-control" type="password" placeholder="Ingresa tu nueva contraseña" />
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label">Confirmar Contraseña</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                                <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="Confirma tu nueva contraseña" />
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-premium shadow-sm">
                            Guardar Contraseña <i class="bi bi-arrow-right ms-2"></i>
                        </button>

                        <div class="text-center mt-3">
                            <a asp-action="Login" class="forgot-link">Volver al inicio de sesión</a>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
