@model ArtemisBankingPro.Presentation.WebApp.ViewModels.AccessDeniedViewModel
@{
    Layout = null;
    ViewData["Title"] = "Acceso Denegado";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #6C5CE7;
            --secondary: #A29BFE;
            --accent: #00D2D3;
            --bg-color: #0b0c10;
            --surface: rgba(255, 255, 255, 0.03);
            --border: rgba(255, 255, 255, 0.08);
            --text-main: #FFFFFF;
            --text-muted: #8e929c;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Outfit', sans-serif; }

        body {
            background-color: var(--bg-color);
            background-image:
                radial-gradient(circle at 10% 20%, rgba(108, 92, 231, 0.12) 0%, transparent 40%),
                radial-gradient(circle at 90% 80%, rgba(0, 210, 211, 0.1) 0%, transparent 40%);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .shape { position: absolute; filter: blur(80px); z-index: -1; animation: float 10s ease-in-out infinite alternate; }
        .shape-1 { width: 400px; height: 400px; background: var(--primary); top: -150px; left: -100px; border-radius: 50%; opacity: 0.6; }
        .shape-2 { width: 350px; height: 350px; background: #e17055; bottom: -150px; right: -50px; border-radius: 50%; opacity: 0.35; animation-delay: -5s; }

        @@keyframes float {
            0% { transform: translateY(0) scale(1); }
            100% { transform: translateY(40px) scale(1.1); }
        }

        .container {
            background: var(--surface);
            backdrop-filter: blur(25px);
            border: 1px solid var(--border);
            border-radius: 28px;
            padding: 55px;
            width: 100%;
            max-width: 500px;
            box-shadow: 0 30px 60px rgba(0,0,0,0.4), inset 0 1px 0 rgba(255,255,255,0.1);
            text-align: center;
            animation: slideUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
            opacity: 0;
            transform: translateY(20px);
            position: relative;
            z-index: 10;
        }

        @@keyframes slideUp { to { transform: translateY(0); opacity: 1; } }

        .icon { font-size: 4rem; margin-bottom: 24px; display: block; }

        h1 {
            font-size: 2rem;
            font-weight: 800;
            background: linear-gradient(135deg, #fff, #fab1a0);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            letter-spacing: -1px;
            margin-bottom: 16px;
        }

        .message {
            background: rgba(255, 71, 87, 0.08);
            border-left: 4px solid #ff4757;
            color: #ff6b7a;
            padding: 16px 20px;
            border-radius: 14px;
            font-size: 1rem;
            margin-bottom: 32px;
            line-height: 1.6;
            text-align: left;
        }

        .btn {
            display: inline-block;
            background: linear-gradient(135deg, var(--primary), #5b4ac9);
            color: white;
            border: none;
            border-radius: 14px;
            padding: 16px 40px;
            font-size: 1rem;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            box-shadow: 0 10px 20px rgba(108, 92, 231, 0.3);
            letter-spacing: 0.5px;
        }

        .btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 30px rgba(108, 92, 231, 0.5);
        }

        .error-code {
            font-size: 5rem;
            font-weight: 800;
            color: rgba(255,255,255,0.04);
            position: absolute;
            top: 20px;
            right: 30px;
            letter-spacing: -4px;
            user-select: none;
        }
    </style>
</head>
<body>
    <div class="shape shape-1"></div>
    <div class="shape shape-2"></div>

    <div class="container">
        <span class="error-code">403</span>
        <span class="icon">🚫</span>
        <h1>Acceso Denegado</h1>

        <div class="message">
            @Model.Message
        </div>

        <a href="/@Model.HomeController/@Model.HomeAction" class="btn">Volver al inicio</a>
    </div>
</body>
</html>
