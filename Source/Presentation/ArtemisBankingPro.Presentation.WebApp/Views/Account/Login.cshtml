@using ArtemisBankingPro.Core.Application.DTOs.Account
@model AuthenticationRequest
@{
    Layout = null;
    ViewData["Title"] = "Iniciar Sesión - Artemis";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Montserrat:wght@700;800;900&display=swap" rel="stylesheet">
    <style>
        :root {
            /* Un azul acero ligeramente más vibrante y moderno */
            --brand-primary: #4472C4; 
            --brand-secondary: #5684D8;
            --brand-accent: #8FAFF0;
            --text-dark: #1F2937;
            --text-light: #F9FAFB;
            --bg-color: #FFFFFF;
            --input-bg: #F4F6F8;
            --border-radius: 8px; 
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-color);
            margin: 0;
            height: 100vh;
            overflow: hidden; 
        }

        .split-layout {
            display: flex;
            height: 100vh;
        }

        /* Lado izquierdo - Imagen de stock de arquitectura bancaria con filtro azul más claro */
        .brand-panel {
            flex: 0 0 30%;
            /* Imagen de arquitectura moderna/banco de Unsplash con overlay sólido azul */
            background: linear-gradient(135deg, rgba(68, 114, 196, 0.88) 0%, rgba(40, 60, 90, 0.88) 100%), 
                        url('https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?q=80&w=2070&auto=format&fit=crop');
            background-size: cover;
            background-position: center;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            color: var(--text-light);
            position: relative;
        }

        /* Lado derecho - Formulario de inicio de sesión */
        .login-panel {
            flex: 1;
            display: flex;
            justify-content: flex-start;
            padding-left: 7vw;
            align-items: center;
            background-color: var(--bg-color);
        }

        .login-card {
            width: 100%;
            max-width: 420px;
            padding: 2.5rem;
            animation: fadeIn 0.8s ease-out;
        }

        .login-header {
            margin-bottom: 2.5rem;
            text-align: left;
        }

        .brand-logo-container {
            display: flex;
            align-items: center;
            gap: 0.4rem;
            margin-bottom: 0.5rem;
        }

        /* Logo puramente tipográfico, minimalista y contundente */
        .brand-logo-text {
            font-family: 'Montserrat', sans-serif;
            font-size: 3.2rem;
            font-weight: 900;
            color: #0F172A; /* Pizarra ultra oscuro */
            letter-spacing: 2px;
            text-transform: uppercase;
            margin: 0;
            line-height: 1;
        }

        .login-header p {
            color: #6B7280;
            font-size: 1.05rem;
            font-weight: 400;
        }

        /* Grupos de inputs sin bordes visibles, fondo gris suave */
        .input-group {
            background-color: var(--input-bg);
            border-radius: var(--border-radius);
            border: 1px solid transparent;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
        }

        .input-group-text {
            background-color: transparent;
            border: none;
            color: #6B7280;
            padding-left: 1.2rem;
            font-size: 1.1rem;
        }

        .form-control {
            background-color: transparent;
            border: none;
            height: 3.6rem;
            font-size: 0.95rem;
            color: var(--text-dark);
            box-shadow: none !important;
            padding-left: 0.8rem;
        }

        .form-control:focus,
        .form-control:active,
        .form-control:focus-visible {
            outline: none !important;
            box-shadow: none !important;
            border: none !important;
            background-color: transparent !important;
        }

        /* Efecto premium al hacer foco en el input */
        .input-group:focus-within {
            background-color: #FFFFFF;
            border-color: var(--brand-accent);
            box-shadow: 0 0 0 4px rgba(87, 108, 188, 0.1);
        }

        .input-group:focus-within .input-group-text i {
            color: var(--brand-primary);
        }

        .form-label {
            font-size: 0.85rem;
            font-weight: 600;
            color: #4B5563;
            margin-bottom: 0.5rem;
        }

        /* Botón principal */
        .btn-premium {
            background-color: var(--brand-primary);
            color: white;
            border: none;
            border-radius: var(--border-radius);
            padding: 0.9rem;
            font-size: 1rem;
            font-weight: 600;
            letter-spacing: 0.5px;
            width: 100%;
            margin-top: 1.5rem;
            transition: all 0.3s ease;
        }

        .btn-premium:hover {
            background-color: var(--brand-secondary);
            transform: translateY(-2px);
            box-shadow: 0 8px 15px rgba(11, 36, 71, 0.2);
            color: white;
        }

        /* Enlaces */
        .forgot-link {
            display: inline-block;
            margin-top: 1.5rem;
            color: #6B7280;
            text-decoration: none;
            font-size: 0.95rem;
            font-weight: 500;
            transition: color 0.2s ease;
        }

        .forgot-link:hover {
            color: var(--brand-accent);
        }

        /* Alerta de validación más sutil y menos roja chillona */
        .validation-alert {
            background-color: #FFFBEB;
            border-left: 4px solid #F59E0B;
            color: #92400E;
            padding: 0.8rem 1rem;
            margin-bottom: 1.5rem;
            border-radius: 4px;
            font-size: 0.95rem;
            display: flex;
            align-items: center;
        }
        
        .validation-alert i {
            margin-right: 0.8rem;
            font-size: 1.2rem;
            color: #D97706;
        }

        .validation-alert ul {
            margin: 0;
            padding: 0;
            list-style: none;
        }

        .validation-alert li {
            margin: 0;
        }

        /* Ocultar el icono de ojo nativo de Edge/IE para usar el nuestro personalizado */
        input[type="password"]::-ms-reveal,
        input[type="password"]::-ms-clear {
            display: none;
        }

        /* Animaciones */
        @@keyframes fadeIn {
            from { opacity: 0; transform: translateX(20px); }
            to { opacity: 1; transform: translateX(0); }
        }

        /* Diseño Responsivo */
        @@media (max-width: 992px) {
            .split-layout {
                flex-direction: column;
            }
            .brand-panel {
                flex: none;
                height: 30vh;
            }
            .login-panel {
                flex: none;
                height: 70vh;
                align-items: flex-start;
                justify-content: center;
                padding-top: 2rem;
                padding-left: 1rem;
                padding-right: 1rem;
            }
        }
    </style>
</head>
<body>

    <div class="split-layout">
        
        <!-- Panel Izquierdo - Fotografía de archivo (Unsplash) con filtro oscuro -->
        <div class="brand-panel">
        </div>

        <!-- Panel Derecho - Formulario -->
        <div class="login-panel">
            <div class="login-card">
                
                <div class="login-header">
                    <div class="brand-logo-container">
                        <!-- Logo puramente tipográfico con un punto de acento -->
                        <div class="brand-logo-text">ARTEMIS<span style="color: var(--brand-primary);">.</span></div>
                    </div>
                    <p>Tu Banco Digital de confianza.</p>
                </div>

                <form asp-controller="Account" asp-action="Login" method="post">
                    
                    @if (ViewData.ModelState.ErrorCount > 0)
                    {
                        <div class="validation-alert">
                            <i class="bi bi-info-circle-fill"></i>
                            <div asp-validation-summary="ModelOnly"></div>
                        </div>
                    }

                    <div class="mb-4">
                        <label class="form-label">Usuario</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person"></i></span>
                            <input asp-for="UserName" class="form-control" placeholder="Ingrese su usuario" required autofocus />
                        </div>
                        <span asp-validation-for="UserName" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label">Contraseña</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock"></i></span>
                            <input asp-for="Password" type="password" id="passwordInput" class="form-control" placeholder="Ingrese su contraseña" required />
                            <button class="btn border-0 text-muted" type="button" id="togglePassword" style="box-shadow: none; padding-right: 1.2rem; display: flex; align-items: center; background-color: transparent;">
                                <i class="bi bi-eye-slash" id="toggleIcon"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <button type="submit" class="btn btn-premium">
                        INICIAR SESIÓN
                    </button>
                </form>

                <div class="text-center">
                    <a href="@Url.Action("ForgotPassword", "Account")" class="forgot-link">¿Olvidó su contraseña?</a>
                </div>

            </div>
        </div>

    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script>
        document.getElementById('togglePassword').addEventListener('click', function (e) {
            const passwordInput = document.getElementById('passwordInput');
            const toggleIcon = document.getElementById('toggleIcon');
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                toggleIcon.classList.remove('bi-eye-slash');
                toggleIcon.classList.add('bi-eye');
            } else {
                passwordInput.type = 'password';
                toggleIcon.classList.remove('bi-eye');
                toggleIcon.classList.add('bi-eye-slash');
            }
        });
    </script>
</body>
</html>
