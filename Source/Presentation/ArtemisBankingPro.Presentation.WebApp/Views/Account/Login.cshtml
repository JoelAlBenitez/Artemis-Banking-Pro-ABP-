@model ArtemisBankingPro.Core.Application.DTOs.Account.AuthenticationRequest
@{
    Layout = null;
    ViewData["Title"] = "Artemis Banking Pro - Login";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <!-- Modern Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #6C5CE7;
            --secondary: #A29BFE;
            --accent: #00D2D3;
            --bg-color: #0b0c10;
            --surface: rgba(255, 255, 255, 0.03);
            --border: rgba(255, 255, 255, 0.08);
            --text-main: #FFFFFF;
            --text-muted: #8e929c;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Outfit', sans-serif;
        }

        body {
            background-color: var(--bg-color);
            background-image: 
                radial-gradient(circle at 10% 20%, rgba(108, 92, 231, 0.12) 0%, transparent 40%),
                radial-gradient(circle at 90% 80%, rgba(0, 210, 211, 0.1) 0%, transparent 40%);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        /* Glassmorphism Background Shapes */
        .shape {
            position: absolute;
            filter: blur(80px);
            z-index: -1;
            animation: float 10s ease-in-out infinite alternate;
        }
        .shape-1 {
            width: 400px; height: 400px;
            background: var(--primary);
            top: -150px; left: -100px;
            border-radius: 50%;
            opacity: 0.6;
        }
        .shape-2 {
            width: 350px; height: 350px;
            background: var(--accent);
            bottom: -150px; right: -50px;
            border-radius: 50%;
            opacity: 0.4;
            animation-delay: -5s;
        }

        @@keyframes float {
            0% { transform: translateY(0) scale(1); }
            100% { transform: translateY(40px) scale(1.1); }
        }

        .login-container {
            background: var(--surface);
            backdrop-filter: blur(25px);
            -webkit-backdrop-filter: blur(25px);
            border: 1px solid var(--border);
            border-radius: 28px;
            padding: 45px 55px;
            width: 100%;
            max-width: 480px;
            box-shadow: 0 30px 60px rgba(0,0,0,0.4), inset 0 1px 0 rgba(255,255,255,0.1);
            transform: translateY(20px);
            opacity: 0;
            animation: slideUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
            position: relative;
            z-index: 10;
        }

        @@keyframes slideUp {
            to { transform: translateY(0); opacity: 1; }
        }

        .logo-area {
            text-align: center;
            margin-bottom: 45px;
        }
        
        .logo-area h1 {
            font-size: 2.4rem;
            font-weight: 800;
            background: linear-gradient(135deg, #fff, var(--secondary));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            letter-spacing: -1px;
            margin-bottom: 8px;
        }

        .logo-area p {
            color: var(--text-muted);
            font-size: 1rem;
            font-weight: 300;
        }

        .input-group {
            margin-bottom: 24px;
            position: relative;
        }

        .input-group label {
            display: block;
            margin-bottom: 8px;
            font-size: 0.9rem;
            font-weight: 600;
            color: var(--text-muted);
            transition: color 0.3s ease;
        }

        .input-group input {
            width: 100%;
            background: rgba(0, 0, 0, 0.25);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 16px 20px;
            color: var(--text-main);
            font-size: 1.05rem;
            transition: all 0.3s ease;
            outline: none;
        }

        .input-group input::placeholder {
            color: rgba(255,255,255,0.15);
        }

        .input-group input:focus {
            background: rgba(0, 0, 0, 0.4);
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(108, 92, 231, 0.15);
        }
        
        /* Efecto al hacer hover/focus en el input */
        .input-group:focus-within label {
            color: var(--primary);
        }

        .forgot-link {
            display: block;
            text-align: right;
            margin-top: -12px;
            margin-bottom: 30px;
            font-size: 0.85rem;
            color: var(--secondary);
            text-decoration: none;
            transition: all 0.3s ease;
            font-weight: 400;
        }

        .forgot-link:hover {
            color: #fff;
            text-shadow: 0 0 10px rgba(162, 155, 254, 0.5);
        }

        .btn-submit {
            width: 100%;
            background: linear-gradient(135deg, var(--primary), #5b4ac9);
            color: white;
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 14px;
            padding: 16px;
            font-size: 1.1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            box-shadow: 0 10px 20px rgba(108, 92, 231, 0.3);
            position: relative;
            overflow: hidden;
            letter-spacing: 0.5px;
        }

        .btn-submit:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 30px rgba(108, 92, 231, 0.5);
            border-color: rgba(255,255,255,0.2);
        }
        
        .btn-submit:active {
            transform: translateY(1px);
        }

        .error-message {
            background: rgba(255, 71, 87, 0.1);
            border-left: 4px solid #ff4757;
            color: #ff4757;
            padding: 14px 18px;
            border-radius: 10px;
            margin-bottom: 24px;
            font-size: 0.95rem;
            animation: shake 0.5s cubic-bezier(0.36, 0.07, 0.19, 0.97) both;
        }

        @@keyframes shake {
            10%, 90% { transform: translate3d(-1px, 0, 0); }
            20%, 80% { transform: translate3d(2px, 0, 0); }
            30%, 50%, 70% { transform: translate3d(-4px, 0, 0); }
            40%, 60% { transform: translate3d(4px, 0, 0); }
        }

        .test-data {
            margin-top: 35px;
            padding-top: 25px;
            border-top: 1px solid var(--border);
            text-align: center;
        }
        
        .test-data p {
            font-size: 0.8rem;
            color: var(--text-muted);
            margin-bottom: 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 600;
        }

        .test-data .badges {
            display: flex;
            justify-content: center;
            gap: 10px;
        }

        .test-data span {
            background: rgba(255,255,255,0.05);
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 0.8rem;
            color: var(--text-muted);
            cursor: pointer;
            transition: all 0.3s ease;
            border: 1px solid transparent;
        }

        .test-data span:hover {
            background: rgba(108, 92, 231, 0.1);
            color: var(--primary);
            border-color: rgba(108, 92, 231, 0.3);
            transform: translateY(-2px);
        }
    </style>
</head>
<body>

    <div class="shape shape-1"></div>
    <div class="shape shape-2"></div>

    <div class="login-container">
        <div class="logo-area">
            <h1>Artemis Banking</h1>
            <p>Acceso Seguro</p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="error-message">
                @Html.ValidationSummary(true, "")
            </div>
        }

        <form asp-action="Login" method="post">
            <div class="input-group">
                <label asp-for="UserName">Nombre de usuario</label>
                <input asp-for="UserName" type="text" placeholder="ej. adminuser" required autocomplete="off" id="UserName" />
            </div>

            <div class="input-group">
                <label asp-for="Password">Contraseña</label>
                <input asp-for="Password" type="password" placeholder="••••••••" required id="Password" />
            </div>

            <!-- Botón de Restablecer contraseña requerido por el documento -->
            <a href="/Account/ForgotPassword" class="forgot-link">Restablecer contraseña</a>

            <button type="submit" class="btn-submit">Iniciar sesión</button>
        </form>

        <div class="test-data">
            <p>Datos Semilla (Clic para llenar)</p>
            <div class="badges">
                <span onclick="copyToForm('adminuser', 'Admin123*')">Admin</span>
                <span onclick="copyToForm('cajerouser', 'Cajero123*')">Cajero</span>
                <span onclick="copyToForm('clienteuser', 'Cliente123*')">Cliente</span>
            </div>
        </div>
    </div>

    <script>
        // Micro-animación para llenar el formulario y hacer focus
        function copyToForm(username, pass) {
            const userInput = document.getElementById('UserName');
            const passInput = document.getElementById('Password');
            
            userInput.value = username;
            passInput.value = pass;
            
            // Animación suave del botón al auto-llenar
            const btn = document.querySelector('.btn-submit');
            btn.style.transform = 'scale(1.02)';
            setTimeout(() => {
                btn.style.transform = 'translateY(0) scale(1)';
            }, 150);
        }
    </script>
</body>
</html>
