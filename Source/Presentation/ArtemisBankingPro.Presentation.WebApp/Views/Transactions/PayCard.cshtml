@using Artemis_Banking_Pro.Core.Application.ViewModels.Transactions
@using Artemis_Banking_Pro.Core.Application.DTOs.SavingsAccounts
@using Artemis_Banking_Pro.Core.Application.DTOs.CreditCards
@model PayCardViewModel
@{
    ViewData["Title"] = "Pagar Tarjeta de Crédito";
    var savingsAccounts = ViewBag.SavingsAccounts as List<SavingsAccountDto> ?? new List<SavingsAccountDto>();
    var creditCards = ViewBag.CreditCards as List<CreditCardDto> ?? new List<CreditCardDto>();
}

<div class="container-fluid py-4" style="font-family: 'Montserrat', sans-serif;">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-dark text-white p-4 border-0">
                    <h3 class="fw-bold mb-1"><i class="bi bi-credit-card-2-front-fill me-2 text-warning"></i> Pagar Tarjeta de Crédito</h3>
                    <p class="mb-0 opacity-75 small">Abona o salda la deuda de tus tarjetas de crédito.</p>
                </div>
                
                <div class="card-body p-4 p-md-5">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger shadow-sm border-0 rounded-4 mb-4">
                            <i class="bi bi-exclamation-circle-fill me-2"></i>
                            <strong>¡Atención!</strong>
                            <div asp-validation-summary="All" class="mt-2 mb-0 small"></div>
                        </div>
                    }

                    @if (!creditCards.Any())
                    {
                        <div class="alert alert-warning border-0 rounded-4 shadow-sm p-4 text-center">
                            <i class="bi bi-exclamation-triangle-fill fs-1 text-warning mb-3 d-block"></i>
                            <h5 class="fw-bold">Sin tarjetas disponibles</h5>
                            <p class="mb-0">No posees tarjetas de crédito activas para realizar pagos.</p>
                        </div>
                    }
                    else
                    {
                        <form asp-controller="Transactions" asp-action="PayCard" method="post" id="payCardForm">
                            
                            <div class="mb-4">
                                <label asp-for="CreditCardId" class="form-label fw-bold text-secondary">Tarjeta a Pagar <span class="text-danger">*</span></label>
                                <select asp-for="CreditCardId" class="form-select form-select-lg border-0 bg-light shadow-sm rounded-4 font-monospace" id="cardSelect" onchange="updateOwedAmount()">
                                    <option value="">Seleccione una tarjeta</option>
                                    @foreach(var card in creditCards)
                                    {
                                        <option value="@card.Id" data-owed="@card.OwedAmount">**** @card.LastFourDigits (Deuda: RD$ @card.OwedAmount.ToString("N2"))</option>
                                    }
                                </select>
                                <span asp-validation-for="CreditCardId" class="text-danger small mt-2 d-block fw-bold"></span>
                            </div>

                            <div class="mb-4">
                                <label asp-for="SourceAccountNumber" class="form-label fw-bold text-secondary">Cuenta de Origen <span class="text-danger">*</span></label>
                                <select asp-for="SourceAccountNumber" class="form-select form-select-lg border-0 bg-light shadow-sm rounded-4 font-monospace">
                                    <option value="">Seleccione cuenta a debitar</option>
                                    @foreach(var account in savingsAccounts)
                                    {
                                        <option value="@account.AccountNumber">@account.AccountNumber - (RD$ @account.Balance.ToString("N2"))</option>
                                    }
                                </select>
                                <span asp-validation-for="SourceAccountNumber" class="text-danger small mt-2 d-block fw-bold"></span>
                            </div>

                            <div class="mb-5">
                                <label asp-for="Amount" class="form-label fw-bold text-secondary">Monto a Pagar <span class="text-danger">*</span></label>
                                <div class="input-group input-group-lg shadow-sm rounded-4 overflow-hidden">
                                    <span class="input-group-text bg-light border-0 text-dark fw-bold">RD$</span>
                                    <input asp-for="Amount" type="number" step="0.01" class="form-control border-0 bg-light font-monospace text-dark fw-bold" placeholder="0.00" autocomplete="off" />
                                </div>
                                <span asp-validation-for="Amount" class="text-danger small mt-2 d-block fw-bold"></span>
                                <div class="form-text text-muted mt-2 small"><i class="bi bi-info-circle me-1"></i> Si pagas más del monto adeudado, solo se debitará el monto exacto de la deuda.</div>
                            </div>

                            <div class="d-flex gap-3 justify-content-end border-top border-secondary border-opacity-25 pt-4">
                                <a asp-controller="Customer" asp-action="Index" class="btn btn-light rounded-pill fw-bold px-4 shadow-sm text-secondary">
                                    Cancelar
                                </a>
                                <button type="submit" class="btn btn-dark rounded-pill fw-bold px-5 shadow-sm">
                                    Procesar Pago <i class="bi bi-check2-circle ms-2"></i>
                                </button>
                            </div>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function updateOwedAmount() {
            var select = document.getElementById('cardSelect');
            var selectedOption = select.options[select.selectedIndex];
            if (selectedOption.value) {
                var owed = selectedOption.getAttribute('data-owed');
                document.getElementById('Amount').value = owed;
            } else {
                document.getElementById('Amount').value = '';
            }
        }
    </script>
}
