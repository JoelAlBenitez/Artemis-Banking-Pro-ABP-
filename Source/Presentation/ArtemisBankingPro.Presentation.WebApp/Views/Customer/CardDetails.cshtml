@using Artemis_Banking_Pro.Core.Application.DTOs.CreditCards
@model IReadOnlyCollection<CardConsumptionDto>
@{
    ViewData["Title"] = "Consumos de Tarjeta";
}

<div class="container-fluid py-4" style="font-family: 'Montserrat', sans-serif;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1" style="color: #0F172A;">Consumos de la Tarjeta</h2>
            <p class="text-muted mb-0">Historial de pagos y consumos registrados.</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-light shadow-sm rounded-pill px-4 fw-bold"><i class="bi bi-arrow-left me-2"></i> Volver</a>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4 py-3 text-secondary fw-bold">Fecha</th>
                            <th class="py-3 text-secondary fw-bold">Comercio / Detalle</th>
                            <th class="py-3 text-secondary fw-bold">Monto</th>
                            <th class="pe-4 py-3 text-secondary fw-bold text-end">Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5 text-muted">No hay consumos registrados.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model.OrderByDescending(x => x.ConsumptionDate))
                            {
                                <tr>
                                    <td class="ps-4 py-3">@item.ConsumptionDate.ToString("dd MMM yyyy, hh:mm tt")</td>
                                    <td class="py-3 text-dark">@item.CommerceName</td>
                                    <td class="py-3 fw-bold text-danger">
                                        RD$ @item.Amount.ToString("N2")
                                    </td>
                                    <td class="pe-4 py-3 text-end">
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 rounded-pill px-3 py-2">@item.StateConsumption</span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
