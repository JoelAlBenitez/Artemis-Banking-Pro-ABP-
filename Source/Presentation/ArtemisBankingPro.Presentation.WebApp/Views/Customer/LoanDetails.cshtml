@using Artemis_Banking_Pro.Core.Application.DTOs.Loans
@model DetailLoansDto
@{
    ViewData["Title"] = "Amortización de Préstamo";
}

<div class="container-fluid py-4" style="font-family: 'Montserrat', sans-serif;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1" style="color: #0F172A;">Detalles del Préstamo</h2>
            <p class="text-muted mb-0">Préstamo @Model?.NumberLoand - Tasa @Model?.AnnualInterestRate%</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-light shadow-sm rounded-3 px-4 fw-bold"><i class="bi bi-arrow-left me-2"></i> Volver</a>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-light">
                <div class="card-body p-4 text-center">
                    <p class="text-muted mb-1">Monto Aprobado</p>
                    <h3 class="fw-bold text-dark mb-0">RD$ @Model?.ApprovedAmount.ToString("N2")</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-light">
                <div class="card-body p-4 text-center">
                    <p class="text-muted mb-1">Plazo</p>
                    <h3 class="fw-bold text-dark mb-0">@Model?.Term meses</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-light">
                <div class="card-body p-4 text-center">
                    <p class="text-muted mb-1">Estado</p>
                    <h3 class="fw-bold text-success mb-0">@Model?.StateLoans</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4 py-3 text-secondary fw-bold">Cuota</th>
                            <th class="py-3 text-secondary fw-bold">Monto</th>
                            <th class="py-3 text-secondary fw-bold">Capital</th>
                            <th class="py-3 text-secondary fw-bold">Interés</th>
                            <th class="pe-4 py-3 text-secondary fw-bold text-end">Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model?.loansInstallmentDtos == null || !Model.loansInstallmentDtos.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">No hay información de cuotas disponible.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var quota in Model.loansInstallmentDtos.OrderBy(x => x.NumberLoanInstallment))
                            {
                                <tr>
                                    <td class="ps-4 py-3 fw-bold">#@quota.NumberLoanInstallment</td>
                                    <td class="py-3">RD$ @quota.InstallmentValue.ToString("N2")</td>
                                    <td class="py-3 text-success">RD$ @quota.CapitalAmount.ToString("N2")</td>
                                    <td class="py-3 text-danger">RD$ @quota.InterestAmount.ToString("N2")</td>
                                    <td class="pe-4 py-3 text-end">
                                        @if (quota.StateInstallment.ToString() == "Pagada" || quota.StateInstallment.ToString() == "Paid")
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-3 py-2">Pagada</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 rounded-pill px-3 py-2 text-dark">Pendiente</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
