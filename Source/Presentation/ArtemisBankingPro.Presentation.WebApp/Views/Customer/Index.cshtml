@using Artemis_Banking_Pro.Core.Application.ViewModels.Dashboard
@using ArtemisBankingPro.Core.Domain.Common.Enum
@model ClientDashboardViewModel
@{
    ViewData["Title"] = "Home del Cliente";
}

<div class="container-fluid py-4" style="font-family: 'Montserrat', sans-serif;">
    <div class="d-flex justify-content-between align-items-center mb-5 border-bottom border-secondary border-opacity-25 pb-3">
        <div>
            <h2 class="fw-bold text-dark mb-1" style="letter-spacing: -0.5px;">Bienvenido, @Model.ClientName</h2>
            <p class="text-secondary mb-0">Este es el resumen de tus productos financieros activos.</p>
        </div>
        <div class="bg-primary bg-opacity-10 text-primary px-4 py-2 rounded-pill fw-bold">
            <i class="bi bi-clock-history me-2"></i> @DateTime.Now.ToString("dd MMMM, yyyy")
        </div>
    </div>

    @if (!Model.SavingsAccounts.Any() && !Model.Loans.Any() && !Model.CreditCards.Any())
    {
        <div class="alert alert-warning shadow-sm border-0 rounded-4 d-flex align-items-center p-4">
            <i class="bi bi-exclamation-triangle-fill fs-3 text-warning me-3"></i>
            <div>
                <h5 class="fw-bold mb-1">Sin productos activos</h5>
                <p class="mb-0 text-secondary">No posee productos financieros activos.</p>
            </div>
        </div>
    }
    else
    {
        <!-- SECCIÓN: CUENTAS DE AHORRO -->
        @if (Model.SavingsAccounts.Any())
        {
            <div class="mb-5">
                <h4 class="fw-bold text-dark mb-3"><i class="bi bi-piggy-bank text-primary me-2"></i> Mis Cuentas de Ahorro</h4>
                <div class="row g-4">
                    @{
                        // Regla: Principal primero, luego Secundarias ordenadas de mayor a menor balance
                        var orderedAccounts = Model.SavingsAccounts
                            .OrderByDescending(a => a.TypeSavingsAccount == SavingsAccountType.Principal)
                            .ThenByDescending(a => a.Balance)
                            .ToList();
                    }

                    @foreach (var account in orderedAccounts)
                    {
                        var isPrincipal = account.TypeSavingsAccount == SavingsAccountType.Principal;
                        <div class="col-md-6 col-lg-4">
                            <div class="card h-100 border-0 shadow-sm rounded-4 position-relative overflow-hidden transition-hover" style="background: linear-gradient(145deg, #ffffff, #f8f9fa);">
                                @if (isPrincipal)
                                {
                                    <div class="position-absolute top-0 end-0 bg-primary text-white px-3 py-1 rounded-start-pill fw-bold shadow-sm" style="font-size: 0.8rem; margin-top: 15px;">
                                        PRINCIPAL
                                    </div>
                                }
                                else
                                {
                                    <div class="position-absolute top-0 end-0 bg-secondary text-white px-3 py-1 rounded-start-pill fw-bold shadow-sm opacity-75" style="font-size: 0.8rem; margin-top: 15px;">
                                        SECUNDARIA
                                    </div>
                                }
                                
                                <div class="card-body p-4">
                                    <p class="text-secondary small fw-bold mb-1">CUENTA DE AHORRO</p>
                                    <h4 class="fw-bold text-dark mb-4 font-monospace">@account.AccountNumber</h4>
                                    
                                    <div class="mb-4">
                                        <p class="text-secondary small mb-1">Balance Actual</p>
                                        <h2 class="fw-bold text-primary mb-0">RD$ @account.Balance.ToString("N2")</h2>
                                    </div>
                                    
                                    <a asp-controller="Customer" asp-action="AccountDetails" asp-route-id="@account.Id" class="btn btn-outline-primary w-100 rounded-pill fw-bold">
                                        Ver detalles
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- SECCIÓN: TARJETAS DE CRÉDITO -->
        @if (Model.CreditCards.Any())
        {
            <div class="mb-5">
                <h4 class="fw-bold text-dark mb-3"><i class="bi bi-credit-card text-primary me-2"></i> Mis Tarjetas de Crédito</h4>
                <div class="row g-4">
                    @foreach (var card in Model.CreditCards)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card h-100 border-0 shadow-sm rounded-4 text-white overflow-hidden transition-hover" style="background: linear-gradient(135deg, #1E293B, #0F172A);">
                                <div class="card-body p-4 position-relative">
                                    <i class="bi bi-wifi position-absolute text-white opacity-50" style="font-size: 2rem; right: 20px; top: 15px;"></i>
                                    
                                    <p class="text-white opacity-75 small fw-bold mb-1">TARJETA DE CRÉDITO</p>
                                    <h4 class="fw-bold text-white mb-4 font-monospace tracking-widest">
                                        **** **** **** @card.LastFourDigits
                                    </h4>
                                    
                                    <div class="row mb-4">
                                        <div class="col-6">
                                            <p class="text-white opacity-75 small mb-1">Monto Adeudado</p>
                                            <h5 class="fw-bold text-danger mb-0">RD$ @card.OwedAmount.ToString("N2")</h5>
                                        </div>
                                        <div class="col-6 text-end">
                                            <p class="text-white opacity-75 small mb-1">Límite / Vence</p>
                                            <div class="fw-bold text-white">RD$ @card.CreditLimit.ToString("N0")</div>
                                            <div class="small opacity-75">@card.ExpirationDate</div>
                                        </div>
                                    </div>
                                    
                                    <a asp-controller="Customer" asp-action="CardDetails" asp-route-id="@card.Id" class="btn btn-light w-100 rounded-pill fw-bold text-dark shadow-sm">
                                        Ver detalles
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- SECCIÓN: PRÉSTAMOS -->
        @if (Model.Loans.Any())
        {
            <div class="mb-5">
                <h4 class="fw-bold text-dark mb-3"><i class="bi bi-cash-coin text-primary me-2"></i> Mis Préstamos</h4>
                <div class="row g-4">
                    @foreach (var loan in Model.Loans)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden transition-hover" style="background-color: #ffffff;">
                                <div class="card-header bg-transparent border-bottom-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
                                    <p class="text-secondary small fw-bold mb-0">PRÉSTAMO #@loan.LoanNumber</p>
                                    @if (loan.CustomerInArrears)
                                    {
                                        <span class="badge bg-danger rounded-pill px-3 py-2 fw-bold shadow-sm">EN MORA</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success rounded-pill px-3 py-2 fw-bold shadow-sm">AL DÍA</span>
                                    }
                                </div>
                                <div class="card-body p-4">
                                    <div class="mb-3">
                                        <p class="text-secondary small mb-1">Monto Pendiente</p>
                                        <h2 class="fw-bold text-dark mb-0">RD$ @loan.PendientAmount.ToString("N2")</h2>
                                    </div>
                                    
                                    <div class="row g-3 mb-4">
                                        <div class="col-6">
                                            <div class="bg-light rounded p-2 text-center h-100">
                                                <p class="text-secondary small mb-0">Capital</p>
                                                <span class="fw-bold text-dark">RD$ @loan.AprovechedCapital.ToString("N0")</span>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="bg-light rounded p-2 text-center h-100">
                                                <p class="text-secondary small mb-0">Tasa Anual</p>
                                                <span class="fw-bold text-dark">@loan.AnnualInterestRate.ToString("N2")%</span>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="bg-light rounded p-2 text-center h-100">
                                                <p class="text-secondary small mb-0">Cuotas Pagadas</p>
                                                <span class="fw-bold text-dark">@loan.InstallmentPay / @loan.QuantityInstallment</span>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="bg-light rounded p-2 text-center h-100">
                                                <p class="text-secondary small mb-0">Plazo</p>
                                                <span class="fw-bold text-dark">@loan.Term Meses</span>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <a asp-controller="Customer" asp-action="LoanDetails" asp-route-id="@loan.Id" class="btn btn-outline-primary w-100 rounded-pill fw-bold">
                                        Ver detalles
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

<style>
    .transition-hover {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }
    .transition-hover:hover {
        transform: translateY(-5px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
    }
    .tracking-widest {
        letter-spacing: 0.15em;
    }
</style>
