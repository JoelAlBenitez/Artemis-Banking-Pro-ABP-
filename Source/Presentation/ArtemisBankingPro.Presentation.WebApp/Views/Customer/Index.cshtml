@using Artemis_Banking_Pro.Core.Application.ViewModels.Dashboard
@model ClientDashboardViewModel
@{
    ViewData["Title"] = "Panel de Cliente";
    var totalBalance = Model.SavingsAccounts?.Sum(s => s.Balance) ?? 0;
}

<div class="dashboard-wrapper" style="font-family: 'Montserrat', sans-serif;">
    <div class="container-fluid py-3">
        
        <!-- Header Compacto -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h4 class="fw-bold mb-0" style="color: #0F172A;">Bienvenido, @(Model.ClientName ?? "Cliente Default")</h4>
                <p class="text-muted mb-0" style="font-size: 0.8rem;">Gestiona tus finanzas y tarjetas en un solo lugar.</p>
            </div>
            <div class="d-flex align-items-center gap-3">
                <div class="bg-white rounded-pill shadow-sm px-3 py-1 d-flex align-items-center text-dark fw-medium" style="font-size: 0.75rem;">
                    <i class="bi bi-calendar3 me-2 text-primary"></i>
                    @DateTime.Now.ToString("dd MMM yyyy", new System.Globalization.CultureInfo("es-ES")).ToUpper()
                </div>
            </div>
        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger shadow-sm border-0 rounded-4 mb-3 py-2">
                <i class="bi bi-exclamation-circle-fill me-2"></i> @TempData["ErrorMessage"]
            </div>
        }

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success shadow-sm border-0 rounded-4 mb-3 py-2">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            </div>
        }

        <!-- PRIMERA FILA: BALANCE Y TARJETA -->
        <div class="row g-3 mb-3 align-items-stretch">
            
            <!-- Balance Total (Más compacto) -->
            <div class="col-xl-7 col-lg-12">
                <div class="card border-0 shadow-sm rounded-4 bg-white h-100">
                    <div class="card-body p-3 p-xl-4 d-flex flex-column flex-md-row justify-content-between align-items-center">
                        
                        <div class="text-center text-md-start mb-3 mb-md-0">
                            <h6 class="text-muted fw-bold mb-1">Balance Total Disponible</h6>
                            <h2 class="fw-bolder text-dark mb-1 text-nowrap" style="letter-spacing: -1px;">
                                <span class="text-primary fs-5 align-top me-1">RD$</span>@totalBalance.ToString("N2")
                            </h2>
                            <p class="text-muted mb-0" style="font-size: 0.75rem;">Actualizado al @DateTime.Now.ToString("dd MMMM - hh:mm tt")</p>
                        </div>

                        <div class="d-flex gap-2">
                            <a asp-controller="Transactions" asp-action="Index" class="quick-action-btn text-decoration-none text-center">
                                <div class="icon-box bg-light rounded-4 mb-1 d-flex justify-content-center align-items-center text-dark transition-all shadow-sm" style="width: 55px; height: 55px;">
                                    <i class="bi bi-arrow-left-right fs-4"></i>
                                </div>
                                <span class="text-dark fw-bold" style="font-size: 0.75rem;">Transferir</span>
                            </a>
                            <a asp-controller="Transactions" asp-action="PayCard" class="quick-action-btn text-decoration-none text-center">
                                <div class="icon-box bg-light rounded-4 mb-1 d-flex justify-content-center align-items-center text-dark transition-all shadow-sm" style="width: 55px; height: 55px;">
                                    <i class="bi bi-credit-card-fill fs-4"></i>
                                </div>
                                <span class="text-dark fw-bold" style="font-size: 0.75rem;">Pagar</span>
                            </a>
                            <a asp-controller="CashAdvance" asp-action="Index" class="quick-action-btn text-decoration-none text-center">
                                <div class="icon-box bg-light rounded-4 mb-1 d-flex justify-content-center align-items-center text-dark transition-all shadow-sm" style="width: 55px; height: 55px;">
                                    <i class="bi bi-cash-coin fs-4"></i>
                                </div>
                                <span class="text-dark fw-bold" style="font-size: 0.75rem;">Avance</span>
                            </a>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Tarjeta de Crédito (Más pequeña) -->
            <div class="col-xl-5 col-lg-12">
                @if (Model.CreditCards != null && Model.CreditCards.Any())
                {
                    var card = Model.CreditCards.First();
                    <div class="bank-card shadow-sm credit-card h-100 position-relative overflow-hidden" style="min-height: 160px;">
                        <div class="card-glass-overlay"></div>
                        <div class="card-body p-3 p-md-4 position-relative z-1 d-flex flex-column h-100">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h6 class="text-white opacity-90 fw-bold mb-0">Tarjeta de Crédito</h6>
                                <div class="text-end">
                                    <span class="fst-italic fw-bold text-white fs-5 d-block line-height-1">Visa</span>
                                </div>
                            </div>
                            
                            <div class="mb-2 mt-auto">
                                <div class="chip-icon mb-2" style="width: 40px; height: 28px;"></div>
                                <h5 class="text-white text-nowrap fw-bold mb-0" style="letter-spacing: 1.5px;">
                                    @card.MaskedCardNumber
                                </h5>
                            </div>
                            
                            <div class="d-flex justify-content-between align-items-end mt-2">
                                <div>
                                    <small class="text-white opacity-75 d-block mb-0" style="font-size: 0.7rem;">DEUDA ACTUAL</small>
                                    <h5 class="text-white mb-0 fw-bold">RD$ @card.OwedAmount.ToString("N2")</h5>
                                </div>
                                <a asp-action="CardDetails" asp-route-id="@card.Id" class="btn btn-sm btn-light bg-white bg-opacity-25 border-0 text-white rounded-pill px-3 py-1 fw-bold" style="font-size: 0.8rem;">
                                    Ver Consumos
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>

        </div>

        <!-- SEGUNDA FILA: CUENTAS Y PRÉSTAMOS -->
        <div class="row g-3 mt-4">
            
            <!-- Cuentas de Ahorro -->
            <div class="col-xl-8 col-lg-12">
                <h5 class="fw-bold mb-3 text-dark">Mis Cuentas de Ahorro</h5>
                <div class="row g-4">
                    @if (Model.SavingsAccounts != null)
                    {
                        foreach (var account in Model.SavingsAccounts)
                        {
                            <div class="col-md-6">
                                <div class="card border-0 rounded-4 shadow-sm h-100 bg-white hover-elevate transition-all">
                                    <div class="card-body p-4 d-flex flex-column">
                                        <div class="d-flex justify-content-between align-items-start mb-3">
                                            <div class="text-primary bg-primary bg-opacity-10 rounded-3 d-flex justify-content-center align-items-center" style="width: 50px; height: 50px;">
                                                <i class="bi bi-piggy-bank fs-4"></i>
                                            </div>
                                            <span class="text-muted fw-bold" style="font-size: 1rem;">
                                                @(account.TypeSavingsAccount.ToString() == "Principal" ? "Cuenta principal" : "Cuenta secundaria")
                                            </span>
                                        </div>
                                        
                                        <div class="mb-4 mt-2">
                                            <p class="text-secondary mb-1" style="font-size: 1.05rem;">@account.AccountNumber</p>
                                            <h2 class="fw-bold text-dark mb-0" style="letter-spacing: -1px;">RD$ @account.Balance.ToString("N2")</h2>
                                        </div>
                                        
                                        <div class="mt-auto pt-2">
                                            <a asp-action="AccountDetails" asp-route-id="@account.Id" class="text-primary text-decoration-none fw-bold d-flex justify-content-between align-items-center w-100" style="font-size: 1.05rem;">
                                                <span>Ver movimientos</span>
                                                <i class="bi bi-arrow-right"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <!-- Préstamos -->
            <div class="col-xl-4 col-lg-12">
                <h5 class="fw-bold mb-3 text-dark">Mis Préstamos</h5>
                <div class="card border-0 shadow-sm rounded-4 bg-white h-100">
                    <div class="card-body p-4">
                        @if (Model.Loans != null && Model.Loans.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-borderless align-middle mb-0">
                                    <tbody>
                                        @foreach (var loan in Model.Loans)
                                        {
                                            <tr class="border-bottom">
                                                <td class="py-4 ps-0" style="width: 60px;">
                                                    <div class="bg-warning bg-opacity-10 text-warning rounded-circle d-flex justify-content-center align-items-center" style="width: 50px; height: 50px;">
                                                        <i class="bi bi-bank fs-3"></i>
                                                    </div>
                                                </td>
                                                <td class="py-4">
                                                    <p class="fw-bold text-dark mb-1" style="font-size: 1.1rem;">Préstamo</p>
                                                    <span class="text-muted" style="font-size: 0.95rem;">ID: @loan.LoanNumber</span>
                                                </td>
                                                <td class="py-4 pe-0 text-end">
                                                    <p class="fw-bold text-danger mb-2" style="font-size: 1.15rem; letter-spacing: -0.5px;">- RD$ @loan.PendientAmount.ToString("N2")</p>
                                                    <a asp-action="LoanDetails" asp-route-id="@loan.Id" class="text-warning text-decoration-none fw-bold" style="font-size: 0.95rem;">
                                                        Ver amortización <i class="bi bi-chevron-right ms-1"></i>
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4 text-muted">
                                <i class="bi bi-info-circle fs-3 d-block mb-1 text-black-50"></i>
                                <span style="font-size: 1rem;">Sin préstamos</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<style>
    body { background-color: #F4F7FE !important; }
    .dashboard-wrapper { min-height: calc(100vh - 60px); }

    .bank-card {
        border-radius: 16px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border: none;
    }
    .bank-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 30px rgba(0,0,0,0.15) !important;
    }

    .credit-card { background: linear-gradient(135deg, #047857, #10B981); }

    .card-glass-overlay {
        position: absolute; top: 0; left: 0; right: 0; bottom: 0;
        background: radial-gradient(circle at top right, rgba(255,255,255,0.15) 0%, transparent 60%);
        pointer-events: none;
    }

    .chip-icon {
        background: linear-gradient(135deg, #FCD34D, #F59E0B);
        border-radius: 6px; position: relative; overflow: hidden;
        box-shadow: inset 0 0 0 1px rgba(0,0,0,0.1);
    }
    .chip-icon::after {
        content: ''; position: absolute; width: 100%; height: 100%;
        background-image: 
            linear-gradient(90deg, transparent 45%, rgba(0,0,0,0.1) 45%, rgba(0,0,0,0.1) 55%, transparent 55%),
            linear-gradient(0deg, transparent 45%, rgba(0,0,0,0.1) 45%, rgba(0,0,0,0.1) 55%, transparent 55%);
        background-size: 10px 10px;
    }

    .quick-action-btn:hover .icon-box {
        background-color: #E2E8F0 !important; transform: scale(1.05);
    }
    .icon-box { background-color: #F8FAFC; }
    
    .transition-all { transition: all 0.2s ease-in-out; }
    
    .hover-elevate:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 16px rgba(0,0,0,0.08) !important;
    }
</style>
