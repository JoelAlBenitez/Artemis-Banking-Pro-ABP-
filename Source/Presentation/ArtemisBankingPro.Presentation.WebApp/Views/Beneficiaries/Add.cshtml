@using Artemis_Banking_Pro.Core.Application.ViewModels.Beneficiaries
@model SaveBeneficiaryViewModel
@{
    ViewData["Title"] = "Agregar Beneficiario";
}

<div class="container-fluid py-4" style="font-family: 'Montserrat', sans-serif;">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-primary text-white p-4 border-0">
                    <h3 class="fw-bold mb-1"><i class="bi bi-person-plus-fill me-2"></i> Agregar Beneficiario</h3>
                    <p class="mb-0 opacity-75 small">Ingresa el número de cuenta de ahorro para registrarlo.</p>
                </div>
                
                <div class="card-body p-4 p-md-5">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger shadow-sm border-0 rounded-4 mb-4">
                            <i class="bi bi-exclamation-circle-fill me-2"></i>
                            <strong>¡Atención!</strong>
                            <div asp-validation-summary="All" class="mt-2 mb-0 small"></div>
                        </div>
                    }

                    <form asp-controller="Beneficiaries" asp-action="Add" method="post">
                        <div class="mb-5">
                            <label asp-for="AccountNumber" class="form-label fw-bold text-secondary">Número de cuenta <span class="text-danger">*</span></label>
                            <div class="input-group input-group-lg shadow-sm rounded-4 overflow-hidden">
                                <span class="input-group-text bg-light border-0"><i class="bi bi-123 text-secondary"></i></span>
                                <input asp-for="AccountNumber" class="form-control border-0 bg-light font-monospace" placeholder="Ej: 123456789" maxlength="9" autocomplete="off" />
                            </div>
                            <span asp-validation-for="AccountNumber" class="text-danger small mt-2 d-block fw-bold"></span>
                            <div class="form-text text-muted mt-2"><i class="bi bi-info-circle me-1"></i> El número de cuenta debe contener exactamente 9 dígitos.</div>
                        </div>

                        <div class="d-flex gap-3 justify-content-end border-top border-secondary border-opacity-25 pt-4">
                            <a asp-controller="Beneficiaries" asp-action="Index" class="btn btn-light rounded-pill fw-bold px-4 shadow-sm text-secondary">
                                Cancelar
                            </a>
                            <button type="submit" class="btn btn-primary rounded-pill fw-bold px-5 shadow-sm">
                                <i class="bi bi-save-fill me-2"></i> Guardar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
