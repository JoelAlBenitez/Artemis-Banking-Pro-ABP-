@using Artemis_Banking_Pro.Core.Application.ViewModels.Beneficiaries
@model List<BeneficiaryListViewModel>
@{
    ViewData["Title"] = "Beneficiarios";
}

<div class="container-fluid py-4" style="font-family: 'Montserrat', sans-serif;">
    <div class="d-flex justify-content-between align-items-center mb-5 border-bottom border-secondary border-opacity-25 pb-3">
        <div>
            <h2 class="fw-bold text-dark mb-1" style="letter-spacing: -0.5px;">Mis Beneficiarios</h2>
            <p class="text-secondary mb-0">Gestiona tus contactos frecuentes para transferencias.</p>
        </div>
        <a asp-controller="Beneficiaries" asp-action="Add" class="btn btn-primary rounded-pill fw-bold px-4 shadow-sm">
            <i class="bi bi-person-plus-fill me-2"></i> Agregar beneficiario
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 rounded-4 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 rounded-4 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info shadow-sm border-0 rounded-4 d-flex align-items-center p-4">
            <i class="bi bi-people-fill fs-3 text-info me-3"></i>
            <div>
                <h5 class="fw-bold mb-1">Sin beneficiarios</h5>
                <p class="mb-0 text-secondary">Aún no tienes beneficiarios registrados. Agrega uno para facilitar tus transferencias.</p>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover table-borderless align-middle mb-0">
                    <thead class="bg-light text-secondary">
                        <tr>
                            <th class="py-3 px-4 fw-bold">NOMBRE</th>
                            <th class="py-3 px-4 fw-bold">APELLIDO</th>
                            <th class="py-3 px-4 fw-bold">NÚMERO DE CUENTA</th>
                            <th class="py-3 px-4 fw-bold text-end">ACCIONES</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var beneficiary in Model)
                        {
                            <tr class="border-bottom border-secondary border-opacity-10">
                                <td class="py-3 px-4 fw-bold text-dark">@beneficiary.Name</td>
                                <td class="py-3 px-4 text-secondary">@beneficiary.LastName</td>
                                <td class="py-3 px-4 font-monospace text-primary fw-bold">@beneficiary.AccountNumber</td>
                                <td class="py-3 px-4 text-end">
                                    <form asp-controller="Beneficiaries" asp-action="Delete" asp-route-id="@beneficiary.Id" method="post" onsubmit="return confirm('¿Está seguro que desea eliminar este beneficiario?');" class="d-inline">
                                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill fw-bold px-3">
                                            <i class="bi bi-trash-fill me-1"></i> Eliminar
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
